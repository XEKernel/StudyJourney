<Window x:Class="GaokaoCountdown.ThemedMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Height="180" Width="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border CornerRadius="10" Background="#FF1A1A32" BorderBrush="#30FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#10FFFFFF" CornerRadius="10,10,0,0">
                <TextBlock x:Name="TitleText" Text="学程" FontSize="13" FontWeight="SemiBold"
                           Foreground="#FFE0E0F0" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Border>

            <!-- 内容 -->
            <Grid Grid.Row="1" Margin="20,16,20,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="IconText" FontSize="24" VerticalAlignment="Top"
                           Margin="0,2,12,0" Foreground="#FF6688CC"/>
                <TextBlock x:Name="MessageText" Grid.Column="1" FontSize="13"
                           Foreground="#CCEEEEF0" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>

            <!-- 按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,16,0">
                <Button x:Name="BtnOk" Content="确定" Width="70" Margin="4,0"
                        Background="#336688CC" Visibility="Collapsed"/>
                <Button x:Name="BtnYes" Content="是" Width="64" Margin="4,0"
                        Background="#33228844" Visibility="Collapsed"/>
                <Button x:Name="BtnNo" Content="否" Width="64" Margin="4,0"
                        Background="#33884444" Visibility="Collapsed"/>
                <Button x:Name="BtnCancel" Content="取消" Width="64" Margin="4,0"
                        Background="#22FFFFFF" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
