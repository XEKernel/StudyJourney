<UserControl x:Class="GaokaoCountdown.MessageBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320" MaxWidth="460">
    <Border CornerRadius="10" Background="#FF1E1E3A" BorderBrush="#40FFFFFF" BorderThickness="1"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#12FFFFFF" CornerRadius="10,10,0,0">
                <TextBlock x:Name="TitleText" Text="学程" FontSize="13" FontWeight="SemiBold"
                           Foreground="#FFE0E0F0" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </Border>

            <Grid Grid.Row="1" Margin="18,14,18,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="IconText" FontSize="22" VerticalAlignment="Top"
                           Margin="0,2,10,0" Foreground="#FF6688CC"/>
                <TextBlock x:Name="MessageText" Grid.Column="1" FontSize="13"
                           Foreground="#CCEEEEF0" TextWrapping="Wrap"/>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,14,0">
                <Button x:Name="BtnOk" Content="确定" Width="64" Margin="3,0"
                        Background="#336688CC" Foreground="White" Visibility="Collapsed"/>
                <Button x:Name="BtnYes" Content="是" Width="56" Margin="3,0"
                        Background="#33228844" Foreground="White" Visibility="Collapsed"/>
                <Button x:Name="BtnNo" Content="否" Width="56" Margin="3,0"
                        Background="#33884444" Foreground="White" Visibility="Collapsed"/>
                <Button x:Name="BtnCancel" Content="取消" Width="56" Margin="3,0"
                        Background="#22FFFFFF" Foreground="White" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
