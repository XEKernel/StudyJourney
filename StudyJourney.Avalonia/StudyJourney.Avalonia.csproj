<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StudyJourney.Avalonia</RootNamespace>
    <AssemblyName>StudyJourneyAvalonia</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- 3.1.0：新增「班级成绩分析」模块（用户可感知的新能力 → Y 位）。
         成绩可从 .xlsx 导入或手动录入；含班级排行榜（总分/单科/进步/退步 + 自定义列 + 前 N 名）、
         个人详情（雷达图对比班级平均 + 与上次逐项对比 + 本学期趋势）、单人 PK、小组 PK（权重可调）、
         波动分析（趋势图 + 稳定/波动/上升/下降/偏科判定，阈值可调）。
         数据落本地 SQLite（grades.db，运行期数据、**绝不能进发布包**）。
         图表为手绘（LiveCharts2 / MiniExcel 经实测否决，理由见 .workbuddy/GRADE_ANALYSIS_PLAN.md）。
         3.0.4：修教师端两个真 bug —— ①端口被占用时远程服务静默起不来（改自动换端口 + 通知）
         ②课表接口嵌套字段是 PascalCase 而网页端按 camelCase 取值 → 登录后课表整片空白。
         3.0.3：代码审查 —— 清理死代码与冗余（界面与功能不变）。
         3.0.2：升级路径加「必经门槛版本」（老版本先升到 3.0.1 再升更高）。
         3.0.1：修「AOT 被误判成框架依赖」（下次更新会下错包）+ 装错包保险。
         3.0.0：分发形态改为 NativeAOT（判据②：分发形态/运行环境变）→ X 位。
         AssemblyVersion 由 <Version> 派生；InformationalVersion 形如 3.0.3+{hash}（更新检查按 '+' 截断解析） -->
    <Version>3.1.0</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.0" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.0.2" />
    <!-- PDF 阅读器（PLANNING 2.1）渲染内核：PDFium 的 .NET 封装，自带各平台原生库。
         本机 api.nuget.org 被拦截 → 走仓库根的 local-nupkg 本地源（见该目录 README）；
         CI 网络正常，直接从 nuget.org 还原。 -->
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <!-- 听力播放器的音频内核（v2.27.0）。
         ⚠ 刻意用 2.2.1 而不是 3.x：NAudio 3.x 的 net9.0 依赖组只带 Core+Midi，
           Windows 播放部件（NAudio.WinMM，含 WaveOutEvent）只在 net9.0-windows7.0，
           而本项目 TFM 是裸 net10.0 → 3.x 整包还原不上（NU1202）。
           2.2.1 的 net6.0 组含 Core/Wasapi/WinMM（不含 WinForms），已验证：restore/build 0 警、
           PublishAot 后 IL2026/IL3050 = 0。详见 PITFALLS §G。 -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- ── 班级成绩分析模块（v3.1.0）────────────────────────────────────────────
         ① Microsoft.Data.Sqlite：成绩库落盘。它只是 ADO.NET 门 + SQLitePCLRaw 的
            DllImport 封装（原生 e_sqlite3 随包分发），**无反射** → AOT 友好。
            版本刻意用 8.0.10：本机 ~/.nuget/packages 已有全部传递依赖
            （sqlitepclraw.bundle_e_sqlite3 2.1.6 / core / lib.e_sqlite3 / provider.e_sqlite3），
            离线即可还原（本机 api.nuget.org 被拦截）。
         ② CommunityToolkit.Mvvm：本模块内的 MVVM。选它而非 ReactiveUI 的唯一理由是
            AOT —— 它的 [ObservableProperty]/[RelayCommand] 全是**源生成器**，运行期零反射；
            ReactiveUI 依赖 Expression 树编译与反射绑定，AOT 下需额外注解且易踩坑。
            ⚠ 只用 ObservableObject / ObservableProperty / RelayCommand；
              **不要用 ObservableValidator**（内部走反射校验），也不要做后期绑定。
         ③ 图表**不引第三方库**（LiveCharts2 已实测否决：其 Avalonia 包依赖 Avalonia 11
            + SkiaSharp 2.88.9，与本项目 Avalonia 12 + SkiaSharp 3.119 双重主版本错位，
            NuGet 会静默升级 SkiaSharp 而让问题逃过构建门禁）。改为手绘 —— 项目既有
            InkCanvas / WhiteboardWindow / BoardRenderer 都是 DrawingContext 手绘，风格一致。
         详见 .workbuddy/GRADE_ANALYSIS_PLAN.md 与 PITFALLS §G。 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <!-- 远程管理：ASP.NET Core Minimal API（Kestrel 后台线程运行，不阻塞 UI 线程） -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- ── GC 内存策略（2026-10-01）──────────────────────────────────────────────
       背景：老师反馈"窗口开多了内存到 200MB，关掉也不降"。实测（SJ_SELFTEST=mem）确认**不是泄漏**
       —— 全部窗口关闭 + GC 后托管堆回落到基线。任务管理器里"不降"的主因是
       **.NET 把回收的内存留在 GC 堆里备用**（复用比还给系统更快），属默认行为的取舍。
       ConserveMemory=5：内存吃紧时让 GC 更积极回收/归还（0=默认不积极，9=最积极）。
       选 5 是官方建议的平衡点 —— 只在有内存压力时起作用，平时不额外增加 GC 次数，
       所以对 CPU 影响有限（本轮刚做过 CPU 优化，不拿它换）。
       另有 RetainVM=false：明确允许把空段还给系统（本就是 .NET 默认值，写出来表明意图）。 -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

  <!-- ⚠ 这里**不能**把 settings.json 打进产物（2026-09-17 修复，数据丢失 BUG）
       原来有 <None Include="..\settings.json" CopyToOutputDirectory="PreserveNewest" />，
       后果是发布包里带着仓库里那份 settings.json，而更新流程是"把包里文件覆盖到程序目录"
       → **每次更新都会把老师的设置冲掉**（账号/课表/上传目录/更新镜像地址全没），
       而且包里的还是开发机的旧测试数据。实测 v2.12.0 的 fd 包 49 个文件里就有它。
       settings.json 属于运行期数据（存在 exe 目录、随文件夹分发），首次启动会自动生成默认值，
       本就不该随发布包分发（注释里也是这么写的）。与 WPF 版共用配置的历史原因已随 WPF 归档失效。 -->

  <!-- 应用资源（托盘图标等） -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- ── 代码签名配置（自签名证书 CN=XEKernel，密码来自环境变量 SIGN_PASSWORD；CI 用 Secrets 自动签名） ── -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SignCertificate>$(MSBuildProjectDirectory)\..\StudyJourney.pfx</SignCertificate>
    <SignPassword Condition="'$(SignPassword)' == ''">$(SIGN_PASSWORD)</SignPassword>
    <SignTimestampUrl>http://timestamp.digicert.com</SignTimestampUrl>
  </PropertyGroup>

  <!-- Release 构建后自动签名（需要 Windows SDK signtool.exe + 本地密码；本地未设密码时跳过，CI 构建将自动签名） -->
  <Target Name="SignOutput" AfterTargets="AfterBuild"
          Condition="'$(Configuration)' == 'Release' And '$(SignPassword)' != '' And Exists('$(SignCertificate)')">
    <Message Text="[Sign] 正在签名: $(TargetPath)" Importance="high" />
    <Exec Command="signtool sign /fd SHA256 /f &quot;$(SignCertificate)&quot; /p $(SignPassword) /tr $(SignTimestampUrl) /td SHA256 /v &quot;$(TargetPath)&quot;"
          IgnoreExitCode="true" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="SignExitCode" />
    </Exec>
    <Warning Condition="'$(SignExitCode)' != '0'" Text="本地签名失败(缺少 Windows SDK 或密码错误)，CI 构建将自动签名" />
  </Target>

  <!-- Release 发布输出自动签名（exe + dll） -->
  <Target Name="SignPublishOutput" AfterTargets="AfterPublish"
          Condition="'$(Configuration)' == 'Release' And '$(SignPassword)' != '' And Exists('$(SignCertificate)')">
    <Message Text="[Sign] 正在签名发布输出: $(PublishDir)" Importance="high" />
    <Exec Command="signtool sign /fd SHA256 /f &quot;$(SignCertificate)&quot; /p $(SignPassword) /tr $(SignTimestampUrl) /td SHA256 /v &quot;$(PublishDir)StudyJourneyAvalonia.exe&quot;"
          IgnoreExitCode="true" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="SignExitCode2" />
    </Exec>
    <Exec Command="signtool sign /fd SHA256 /f &quot;$(SignCertificate)&quot; /p $(SignPassword) /tr $(SignTimestampUrl) /td SHA256 /v &quot;$(PublishDir)StudyJourneyAvalonia.dll&quot;"
          IgnoreExitCode="true" ContinueOnError="true" Condition="'$(SignExitCode2)' == '0'" />
  </Target>

</Project>
