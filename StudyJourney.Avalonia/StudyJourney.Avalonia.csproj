<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StudyJourney.Avalonia</RootNamespace>
    <AssemblyName>StudyJourneyAvalonia</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.0.2" />
  </ItemGroup>

  <!-- 与 WPF 版共用 settings.json / schedule.json（迁移规划：数据文件共用） -->
  <ItemGroup>
    <None Include="..\settings.json" Link="settings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\schedule_example.json" Link="schedule.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
