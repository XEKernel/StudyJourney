<UserControl x:Class="StudyJourney.Avalonia.Views.Settings.ReminderPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="16" Margin="0,8,16,16">

            <!-- 上课提醒 -->
            <Border CornerRadius="8" Background="#14FFFFFF" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="上课提醒" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="课前与上课中的提醒" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <StackPanel Spacing="10" Margin="0,10,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="预备铃（提前 2 分钟）" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="True"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="上课提醒" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="True"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="课间提醒（距下节课）" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="False"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 下课提醒 -->
            <Border CornerRadius="8" Background="#14FFFFFF" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="下课提醒" FontSize="16" FontWeight="SemiBold"/>
                    <StackPanel Spacing="10" Margin="0,10,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="下课提醒" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="True"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="60 秒下课倒计时" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="True"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="倒计时提示音" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="True"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="一天结束提醒" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="True"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 提示音 -->
            <Border CornerRadius="8" Background="#14FFFFFF" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="提示音" FontSize="16" FontWeight="SemiBold"/>
                    <StackPanel Spacing="10" Margin="0,10,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="启用提示音" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="True"/>
                        </Grid>
                        <Grid ColumnDefinitions="110,*">
                            <TextBlock Text="声音文件" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Watermark="留空使用系统默认" IsReadOnly="False"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
