<UserControl x:Class="StudyJourney.Avalonia.Views.Settings.AboutPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia">
    <ScrollViewer>
        <StackPanel Margin="0,8,16,16">

            <!-- 关于 -->
            <Border CornerRadius="8" Background="#14FFFFFF" Padding="24,20">
                <StackPanel>
                    <TextBlock Text="学程" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="高考倒计时伴侣 · Avalonia 迁移原型"
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="版本 1.7.0（迁移中）"
                               FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="GitHub 仓库"/>
                        <Button Content="检查更新"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 说明 -->
            <Border CornerRadius="8" Background="#14FFFFFF" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="关于本原型" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="这是学程从 WPF 迁移到 Avalonia 的阶段原型。本窗口展示 WinUI 3 样式（FluentAvalonia 主题 + Mica 材质 + NavigationView 导航）在设置页面的应用效果。"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
