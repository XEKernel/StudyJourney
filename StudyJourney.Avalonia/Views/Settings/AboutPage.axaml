<UserControl x:Class="StudyJourney.Avalonia.Views.Settings.AboutPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="14" Margin="0,8,20,20">

            <!-- 应用信息 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="24,20">
                <StackPanel Spacing="12">
                    <TextBlock Text="学程" FontSize="28" FontWeight="Bold"/>
                    <TextBlock x:Name="VersionTb" Text="版本"
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="高考倒计时桌面伴侣 · Avalonia 版"
                               FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                        <Button Content="GitHub 仓库" Click="GitHubRepoBtn_Click"/>
                        <Button Content="立即检查更新" Click="CheckUpdateBtn_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatusTb" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" IsVisible="False"/>
                </StackPanel>
            </Border>

            <!-- 更新设置 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="更新" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="AutoCheckUpdateCheck" Content="启动时自动检查更新"/>
                    <TextBlock Text="发现新版本后会弹出对话框提示" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="24,0,0,0" TextWrapping="Wrap"/>

                    <CheckBox x:Name="UseProxyCheck" Content="下载更新走国内加速镜像（推荐）"
                              Margin="0,8,0,0" IsCheckedChanged="UseProxyCheck_Changed"/>
                    <TextBlock Text="国内直连 GitHub 下载很慢甚至不通，开启后经镜像下载（只加速更新包，不涉及其它联网功能）"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="24,0,0,0" TextWrapping="Wrap"/>

                    <StackPanel x:Name="ProxyBoxPanel" Spacing="4" Margin="24,6,0,0">
                        <TextBlock Text="镜像地址（一般不用改）" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBox x:Name="ProxyPrefixBox" FontSize="12"
                                 PlaceholderText="留空 = 直连 GitHub"
                                 TextChanged="ProxyPrefixBox_TextChanged"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 诊断与记录（2026-09-24 新增） -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="6">
                    <TextBlock Text="🔍  诊断与记录" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="记录上课时实际打开过哪些文件（自动化打开的和老师自己打开的）、U 盘插拔，便于分析课件顺序规律；也可以生成一个诊断包发给开发者。"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <CheckBox x:Name="RecordActivityCheck" Margin="0,6,0,0"
                              Content="记录上课活动（含老师手动打开的文件、U 盘插拔）"
                              IsCheckedChanged="RecordActivity_Changed"/>
                    <TextBlock Text="记录写在程序目录的 records 文件夹里，一天一个文件；不含密码与登录凭据。"
                               FontSize= "11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="24,0,0,0"/>

                    <!-- 打包内容（2026-09-24 用户要求：树深一点 / 内容可自定义） -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                        <TextBlock Text="目录树深度" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ComboBox x:Name="DiagDepthCombo" Width="96" FontSize="12"
                                  SelectionChanged="DiagOption_Changed">
                            <ComboBoxItem Content="3 层"/>
                            <ComboBoxItem Content="5 层"/>
                            <ComboBoxItem Content="8 层"/>
                            <ComboBoxItem Content="12 层"/>
                        </ComboBox>
                        <CheckBox x:Name="DiagCoursewareTreeCheck" FontSize="12" VerticalAlignment="Center"
                                  Content="附带课件目录树" IsCheckedChanged="DiagOption_Changed"/>
                    </StackPanel>
                    <TextBlock Text="额外要打包目录树的路径（每行一个，可填教学资料盘 / U 盘；留空则不加）"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBox x:Name="DiagExtraDirsBox" FontSize="12" AcceptsReturn="True" MinHeight="50"
                             TextWrapping="Wrap" LostFocus="DiagExtraDirs_LostFocus"
                             PlaceholderText="D:\教学资料"/>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                        <Button x:Name="DiagPackBtn" Content="生成诊断包…" Click="DiagPackBtn_Click"/>
                        <TextBlock x:Name="DiagStatusTb" Text="" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" MaxWidth="360"/>
                    </StackPanel>
                    <TextBlock Text="诊断包含：活动记录 / 课件清单（带解析序号）/ 桌面文件树 / 课件目录树 / 额外目录树 / 配置快照（已剔除密码，不含 token）/ 系统信息 / 日志尾部。生成到桌面。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 说明 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="关于" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="学程（Study Journey）是一款高考倒计时桌面伴侣：倒计时小组件 + 课表悬浮栏 + 考试模式 + 每日一言 + 天气。本版基于 Avalonia + FluentAvalonia 构建，采用 WinUI 3 风格界面。"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
