<UserControl x:Class="StudyJourney.Avalonia.Views.Settings.AboutPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="14" Margin="0,8,20,20">

            <!-- 应用信息 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="24,20">
                <StackPanel Spacing="12">
                    <TextBlock Text="学程" FontSize="28" FontWeight="Bold"/>
                    <TextBlock x:Name="VersionTb" Text="版本"
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="高考倒计时桌面伴侣 · Avalonia 版"
                               FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                        <Button Content="GitHub 仓库" Click="GitHubRepoBtn_Click"/>
                        <Button Content="立即检查更新" Click="CheckUpdateBtn_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatusTb" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" IsVisible="False"/>
                </StackPanel>
            </Border>

            <!-- 更新设置 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="更新" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="AutoCheckUpdateCheck" Content="启动时自动检查更新"/>
                    <TextBlock Text="发现新版本后会弹出对话框提示" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="24,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 说明 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="关于" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="学程（Study Journey）是一款高考倒计时桌面伴侣：倒计时小组件 + 课表悬浮栏 + 考试模式 + 每日一言 + 天气。本版基于 Avalonia + FluentAvalonia 构建，采用 WinUI 3 风格界面。"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
