<UserControl x:Class="StudyJourney.Avalonia.Views.Settings.SchedulePage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="14" Margin="0,8,20,20">

            <!-- 提醒 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="提醒" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="RemindClassStartCheck" Content="预备铃（提前 2 分钟）" IsChecked="True"/>
                    <CheckBox x:Name="RemindClassMidCheck" Content="上课提醒" IsChecked="True" Margin="0,6,0,0"/>
                    <CheckBox x:Name="RemindNextClassSoonCheck" Content="课间提醒（距下一节课）" IsChecked="True" Margin="0,6,0,0"/>
                    <CheckBox x:Name="RemindClassEndSoon10Check" Content="距离下课 10 分钟提醒" IsChecked="True" Margin="0,6,0,0"/>
                    <CheckBox x:Name="RemindClassEndSoonCheck" Content="距离下课 1 分钟提醒" IsChecked="True" Margin="0,6,0,0"/>
                    <CheckBox x:Name="RemindClassEndCheck" Content="下课提醒" IsChecked="True" Margin="0,6,0,0"/>
                    <CheckBox x:Name="RemindDayEndCheck" Content="一天结束提醒" IsChecked="True" Margin="0,6,0,0"/>
                    <CheckBox x:Name="RemindSpecialPeriodCheck" Content="特殊时段提醒（早自习/晚自习等）" Margin="0,6,0,0"/>

                    <CheckBox x:Name="EnableReminderSoundCheck" Content="启用提醒提示音" Margin="0,10,0,0"/>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBox x:Name="ReminderSoundPathBox" PlaceholderText="留空使用系统默认音"/>
                        <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="BrowseReminderSound_Click"/>
                    </Grid>

                    <TextBlock Text="提醒方式" FontSize="13" Margin="0,10,0,4"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton x:Name="ReminderStyleCapsule" Content="胶囊弹窗" GroupName="ReminderStyle" IsChecked="True"/>
                        <RadioButton x:Name="ReminderStyleToast" Content="Windows 通知" GroupName="ReminderStyle"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 课表编辑 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="📋  课表编辑" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="编辑每周课程：星期 1-7、节次、科目、时间。保存后立即生效。"
                               FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"/>
                    <Button Content="编辑课表数据…" HorizontalAlignment="Left" Margin="0,4,0,0"
                            Click="EditScheduleBtn_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
