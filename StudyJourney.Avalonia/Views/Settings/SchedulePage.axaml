<UserControl x:Class="StudyJourney.Avalonia.Views.Settings.SchedulePage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="14" Margin="0,8,20,20">

            <!-- 提醒 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="提醒" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <!-- 快捷档（v2.22.0，规划 2.7 P2）：原来 8 个开关平铺、出厂默认还分散 → 先给档位 -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="ReminderPresetCombo" Width="220"/>
                        <Button x:Name="ApplyReminderPresetBtn" Content="套用" Click="ApplyReminderPresetBtn_Click"/>
                    </StackPanel>
                    <TextBlock Text="选一档直接套用；想单独开关某项，展开下面的「逐项开关」。改完按「保存设置」生效。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <Expander Header="逐项开关（高级）" FontSize="12" IsExpanded="False" Margin="0,6,0,0">
                        <StackPanel Spacing="4" Margin="0,6,0,0">
                            <CheckBox x:Name="RemindClassStartCheck" Content="预备铃（提前 2 分钟）" IsChecked="True"/>
                            <CheckBox x:Name="RemindClassMidCheck" Content="上课提醒" IsChecked="True"/>
                            <CheckBox x:Name="RemindNextClassSoonCheck" Content="课间提醒（距下一节课）" IsChecked="True"/>
                            <CheckBox x:Name="RemindClassEndSoon10Check" Content="距离下课 10 分钟提醒" IsChecked="True"/>
                            <CheckBox x:Name="RemindClassEndSoonCheck" Content="距离下课 1 分钟提醒" IsChecked="True"/>
                            <CheckBox x:Name="RemindClassEndCheck" Content="下课提醒" IsChecked="True"/>
                            <CheckBox x:Name="RemindDayEndCheck" Content="一天结束提醒" IsChecked="True"/>
                            <CheckBox x:Name="RemindSpecialPeriodCheck" Content="特殊时段提醒（早自习/晚自习等）"/>
                        </StackPanel>
                    </Expander>

                    <CheckBox x:Name="EnableReminderSoundCheck" Content="启用提醒提示音" Margin="0,10,0,0"/>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBox x:Name="ReminderSoundPathBox" PlaceholderText="留空使用系统默认音"/>
                        <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="BrowseReminderSound_Click"/>
                    </Grid>

                    <TextBlock Text="提醒方式" FontSize="13" Margin="0,10,0,4"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton x:Name="ReminderStyleCapsule" Content="胶囊弹窗" GroupName="ReminderStyle" IsChecked="True"/>
                        <RadioButton x:Name="ReminderStyleToast" Content="Windows 通知" GroupName="ReminderStyle"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 按科目设置（v2.26.0）：给指定科目单独设「提示音 / 上课显示」 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="🎧  按科目设置（提示音 / 上课显示）" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="给某节课单独设表现，没配的科目按上面的全局开关走。例：听力课选「静音」（不出声，但仍显示进度条）；晚自习选「完全安静」（不出声，上课时整个窗口也不显示）。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"/>

                    <Grid ColumnDefinitions="*,*,Auto" Margin="0,4,0,0">
                        <ComboBox x:Name="PresenceSubjectCombo" FontSize="12"/>
                        <ComboBox x:Name="PresencePresetCombo" Grid.Column="1" Margin="8,0,0,0" FontSize="12"/>
                        <Button Grid.Column="2" Content="＋ 添加 / 修改" Margin="8,0,0,0" Padding="12,4"
                                FontSize="12" Click="PresenceAddBtn_Click"/>
                    </Grid>

                    <StackPanel x:Name="PresenceList" Spacing="4"/>
                    <TextBlock x:Name="PresenceEmptyTb" Text="（还没有按科目的设置）" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="选「正常」等于不改这一项（会从列表里去掉）。改完按窗口下方「保存设置」生效。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 听力播放器（v2.27.0，规划 2.9）——本卡片的改动**即时生效**（存 listening.json，与上面的设置无关） -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="🎧  听力播放器" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="听力录音用内置播放器播：整份播完自动关窗，并记下听到哪一份（听一半关掉不会算「听过」，下次续播同一份）。本卡片的改动即时生效，不用点「保存设置」。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"/>

                    <!-- 已有来源 -->
                    <StackPanel x:Name="ListeningSourceList" Spacing="4"/>
                    <TextBlock x:Name="ListeningEmptyTb" Text="（还没有听力来源，先在下面添加一个）"
                               FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <!-- 添加来源 -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <StackPanel Spacing="6">
                            <TextBox x:Name="ListeningNameBox" PlaceholderText="来源名称（如：资料A / 周考卷）" FontSize="12"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="ListeningDirBox" FontSize="12"
                                         PlaceholderText="录音所在文件夹，如 D:\\听力\\资料A"/>
                                <Button Grid.Column="1" Content="浏览…" Margin="6,0,0,0" FontSize="11"
                                        Padding="10,3" Click="ListeningBrowseDir_Click"/>
                            </Grid>
                            <CheckBox x:Name="ListeningOnceCheck" IsChecked="True"
                                      Content="临时来源（播完自动回到上一个来源；随手扔的文件夹/桌面选它）"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="＋ 添加" Margin="8,0,0,0" Padding="12,4" FontSize="12"
                                VerticalAlignment="Top" Click="ListeningAddSource_Click"/>
                    </Grid>

                    <!-- 例外日 -->
                    <TextBlock Text="例外日（这些日期不自动播放，也不推进进度 —— 例如英语周考由全校广播播放）"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="Auto,Auto,*">
                        <DatePicker x:Name="ListeningSkipDate" Width="150" FontSize="12"/>
                        <Button Grid.Column="1" Content="＋ 加为例外日" Margin="8,0,0,0" Padding="10,3" FontSize="11"
                                Click="ListeningAddSkipDate_Click"/>
                        <WrapPanel Grid.Column="2" x:Name="ListeningSkipList" Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <CheckBox x:Name="ListeningSkipIfExamCheck"
                              Content="当天课表里有英语考试时也自动跳过（默认关）"/>
                    <Button Content="清空全部例外日" FontSize="11" Padding="10,3" HorizontalAlignment="Left"
                            Click="ListeningClearSkipDates_Click"/>

                    <!-- 播放行为 -->
                    <Grid ColumnDefinitions="Auto,Auto,20,Auto,*" Margin="0,6,0,0">
                        <TextBlock Text="播完后延时" FontSize="12" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1" x:Name="ListeningAutoCloseBox" Minimum="-1" Maximum="60"
                                       Increment="1" FormatString="0" FontSize="12" Width="110" Margin="6,0,0,0"
                                       ValueChanged="ListeningAutoClose_Changed"/>
                        <TextBlock Grid.Column="2" Text="秒自动关窗" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="音量" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <Slider Grid.Column="4" x:Name="ListeningVolumeSlider" Minimum="0" Maximum="100"
                                Width="130" ValueChanged="ListeningVolume_Changed"/>
                    </Grid>
                    <TextBlock Text="延时填 -1 = 播完不自动关（窗口留着）；填 0 = 立刻关。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="▶ 现在听一次" Padding="12,5" FontSize="12" Click="ListeningPlayNow_Click"/>
                        <Button Content="打开播放器窗口" Padding="12,5" FontSize="12" Click="ListeningOpenPlayer_Click"/>
                        <TextBlock x:Name="ListeningHintTb" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 课表编辑 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="📋  课表编辑" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="编辑每周课程：星期 1-7、节次、科目、时间。保存后立即生效。"
                               FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"/>
                    <Button Content="编辑课表数据…" HorizontalAlignment="Left" Margin="0,4,0,0"
                            Click="EditScheduleBtn_Click"/>
                </StackPanel>
            </Border>

            <!-- 调休（补课日） -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="🗓  调休（补课日）" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="调休日按所选星期执行课表与自动化规则。例：周日补周五的课 → 周日会走周五的课表，周五中午的听力自动化也会照常触发。"
                               FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <DatePicker x:Name="MakeupDatePicker" Width="150"/>
                        <TextBlock Text="补" VerticalAlignment="Center"/>
                        <ComboBox x:Name="MakeupDayCombo" Width="100"/>
                        <Button x:Name="MakeupAddBtn" Content="添加 / 修改"
                                Click="MakeupAdd_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="MakeupListPanel" Spacing="4" Margin="0,6,0,0"/>
                    <TextBlock x:Name="MakeupEmptyTb" Text="（暂无调休日）" FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
