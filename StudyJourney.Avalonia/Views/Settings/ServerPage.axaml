<UserControl x:Class="StudyJourney.Avalonia.Views.Settings.ServerPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="14" Margin="0,8,20,20">

            <!-- 远程服务开关 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="🌐 远程服务" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ToggleSwitch x:Name="ServerToggle" OnContent="运行中" OffContent="已停止"
                                  IsCheckedChanged="ServerToggle_IsCheckedChanged"/>
                    <TextBlock x:Name="ServerStatusTb" Text="未开启" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                    <CheckBox x:Name="AutoStartServerCheck" Content="启动软件时自动开启远程服务" Margin="0,10,0,0"/>
                    <TextBlock Text="老师可用浏览器访问 http://本机IP:8080 进行课表管理、课件投递、班级状态查看。&#10;服务改动需在「保存设置」后、且重启远程服务才生效（本页开关可立即启停）。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="24,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 上传目录 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="📁 课件存放位置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="老师上传的课件会保存到这里。点选即可，无需手动输入路径。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"/>
                    <!-- SelectedIndex 在代码构造函数中设置：XAML 加载期设置会提前触发事件，
                         而此时其后的控件（CustomDirPanel/UploadDirPreviewTb）尚未实例化 → 空引用崩溃 -->
                    <ComboBox x:Name="UploadDirCombo" Margin="0,8,0,0"
                              SelectionChanged="UploadDirCombo_SelectionChanged">
                        <ComboBoxItem Content="默认位置（推荐）"/>
                        <ComboBoxItem Content="桌面"/>
                        <ComboBoxItem Content="桌面\课件"/>
                        <ComboBoxItem Content="文档"/>
                        <ComboBoxItem Content="下载"/>
                        <ComboBoxItem Content="自定义路径…"/>
                    </ComboBox>
                    <StackPanel x:Name="CustomDirPanel" IsVisible="False" Margin="0,8,0,0" Spacing="4">
                        <!-- v2.23.0（2.7 P3）：原来只让"手打完整路径（高级用户）"，与"老师零门槛"矛盾 →
                             给「浏览…」按钮选文件夹（也可以直接粘贴路径） -->
                        <TextBlock Text="自定义目录（点「浏览…」选文件夹，或直接粘贴路径）" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="CustomDirBox"
                                     PlaceholderText="如 D:\课件 或 D:\XX课件"
                                     FontSize="13" TextChanged="CustomDirBox_TextChanged"/>
                            <Button Grid.Column="1" Content="浏览…" Click="BrowseCustomDir_Click"/>
                        </Grid>
                    </StackPanel>
                    <TextBlock x:Name="UploadDirPreviewTb" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="修改后保存设置，并重新开启远程服务（或重启软件）生效。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 班级信息 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="🏫 班级信息" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="班级名称（教师端控制台顶部显示）" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="ClassNameBox" Text="高三（2）班 智慧黑板" FontSize="13" Margin="0,4,0,10"/>
                    <TextBlock Text="老师名字（登录状态与操作日志显示）" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="TeacherNameBox" Text="老师" FontSize="13" Margin="0,4,0,0"/>
                    <TextBlock Text="修改后保存设置生效；老师也可在网页端「班级状态」页自行修改。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 老师账号 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="👥 老师账号" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <!-- v2.29.0 安全加固：默认密码风险提示（仅在有账号仍用公开默认密码时显示） -->
                    <Border x:Name="TeacherRiskBanner" CornerRadius="6" Background="#33C81E1E"
                            BorderBrush="#66E57373" BorderThickness="1" Padding="10,8" Margin="0,0,0,6"
                            IsVisible="False">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="TeacherRiskTitle" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#FFFF8A80" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TeacherRiskDetail" FontSize="11"
                                       Foreground="#FFEF9A9A" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="远程管理登录账号（语数英物化生 + 管理员）。选中行可编辑，点「更新选中」保存到列表。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"/>
                    <ListBox x:Name="TeacherListBox" Height="150" Margin="0,6,0,0"
                             SelectionChanged="TeacherListBox_SelectionChanged"/>
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6" Margin="0,8,0,0">
                        <TextBox x:Name="TUsernameBox" PlaceholderText="用户名" FontSize="12"/>
                        <TextBox x:Name="TPasswordBox" Grid.Column="1" PlaceholderText="密码(留空=不改)" FontSize="12"/>
                        <TextBox x:Name="TDisplayNameBox" Grid.Column="2" PlaceholderText="显示名" FontSize="12"/>
                        <TextBox x:Name="TSubjectBox" Grid.Column="3" PlaceholderText="科目" FontSize="12"/>
                    </Grid>
                    <TextBlock Text="密码以加密形式存储、不显示不回读；编辑老师时留空 = 保持原密码，新增账号留空 = 自动生成一个随机密码并在提示框里显示一次。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="➕ 添加账号" Click="AddTeacherBtn_Click"/>
                        <Button Content="💾 更新选中" Click="UpdateTeacherBtn_Click"/>
                        <Button Content="🗑 删除选中" Click="DeleteTeacherBtn_Click"/>
                    </StackPanel>
                    <TextBlock Text="修改后点「保存设置」生效；网页端登录下拉与登录校验即时使用新列表（已登录会话不受删除影响）。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 操作日志（v2.22.0，规划 2.7 P2：6 个分区平铺过载 → 排查用的日志收进折叠区） -->
            <Expander Header="📋 操作日志（排查用 —— 一般不用看）" FontSize="13" IsExpanded="False">
                <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16" Margin="0,8,0,0">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="最近 30 条远程操作（登录 / 修改课表 / 上传课件）"
                                   FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="刷新日志" Click="RefreshLogsBtn_Click"/>
                    </Grid>
                    <Border Background="#12000000" CornerRadius="6" Padding="10,8" Margin="0,6,0,0">
                        <TextBlock x:Name="LogsTb" Text="（暂无操作日志）" FontSize="12"
                                   FontFamily="Consolas,Courier New,monospace"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" MaxHeight="260"/>
                    </Border>
                    <TextBlock x:Name="LogPathTb" Text="" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
