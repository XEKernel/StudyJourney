<UserControl x:Class="StudyJourney.Avalonia.Views.Settings.ApiPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="14" Margin="0,8,20,20">

            <!-- 💬 每日一言 -->
            <TextBlock Text="💬 每日一言" FontSize="15" FontWeight="SemiBold"
                       Foreground="#FF8899FF" Margin="4,0,0,0"/>

            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="每日一言开关" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ShowDailyQuoteCheck" Content="在倒计时窗口底部显示每日一言" IsChecked="True"/>
                    <TextBlock Text="每日随机展示一条名言/诗词，点击可手动刷新"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="24,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="显示样式" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid ColumnDefinitions="70,*,80" Margin="0,2,0,6">
                        <TextBlock Text="字体大小" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <Slider x:Name="QuoteFontSizeSlider" ValueChanged="QuoteFontSizeSlider_ValueChanged" Grid.Column="1" Minimum="8" Maximum="24" Value="12" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="QuoteFontSizeText" Grid.Column="2" Text="12" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="70,*,Auto" Margin="0,4,0,6">
                        <TextBlock Text="文字颜色" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBox x:Name="QuoteForegroundBox" Grid.Column="1" Text="#FFAAAAAA"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                            <Border Width="26" Height="26" CornerRadius="4" Background="#FFAAAAAA"/>
                            <Button Content="选择…" Click="PickQuoteForeground_Click"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="QuoteItalicCheck" Content="斜体" IsChecked="True"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="数据来源" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid ColumnDefinitions="70,*" Margin="0,2,0,6">
                        <TextBlock Text="API 地址" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBox x:Name="QuoteApiUrlBox" Grid.Column="1" Text="https://uapis.cn/api/v1/saying"/>
                    </Grid>
                    <TextBlock Text="返回格式应为 {&quot;text&quot;: &quot;...&quot;}（与 uapis.cn 兼容）"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="70,0,0,0" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="70,*" Margin="0,10,0,6">
                        <TextBlock Text="文本字段" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBox x:Name="QuoteTextFieldNameBox" Grid.Column="1" Text="text"/>
                    </Grid>
                    <Grid ColumnDefinitions="70,*,80" Margin="0,10,0,6">
                        <TextBlock Text="自动切换" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <Slider x:Name="QuoteRefreshIntervalSlider" ValueChanged="QuoteRefreshIntervalSlider_ValueChanged" Grid.Column="1" Minimum="0" Maximum="120" Value="30" TickFrequency="5" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="QuoteRefreshIntervalText" Grid.Column="2" Text="30秒" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="0 = 不自动切换；设置后每隔 N 秒自动刷新一条新的一言"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="70,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 分隔线 -->
            <Border Height="1" Background="#20FFFFFF" Margin="4,4,4,4"/>

            <!-- ☁ 天气 -->
            <TextBlock Text="☁ 天气" FontSize="15" FontWeight="SemiBold"
                       Foreground="#FF88CCFF" Margin="4,0,0,0"/>

            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="城市设置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid ColumnDefinitions="70,*" Margin="0,2,0,6">
                        <TextBlock Text="城市名称" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBox x:Name="WeatherCityBox" Grid.Column="1" Text="北京"/>
                    </Grid>
                    <Grid ColumnDefinitions="70,*" Margin="0,6,0,6">
                        <TextBlock Text="行政区划代码" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBox x:Name="WeatherAdcodeBox" Grid.Column="1" Text="110000" PlaceholderText="可选，留空自动匹配"/>
                    </Grid>
                    <TextBlock Text="城市名必填；adcode 可选（6 位数字，如 110105=朝阳区）"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="70,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="文本字体大小" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid ColumnDefinitions="70,*,50">
                        <TextBlock Text="字号" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <Slider x:Name="WeatherFontSizeSlider" ValueChanged="WeatherFontSizeSlider_ValueChanged" Grid.Column="1" Minimum="10" Maximum="36" Value="14" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="WeatherFontSizeText" Grid.Column="2" Text="14" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="文字颜色" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="城市名颜色" FontSize="13" Margin="0,4,0,4"/>
                    <Grid ColumnDefinitions="90,*,Auto">
                        <TextBox x:Name="WeatherCityColorBox" Grid.Column="0" Text="#FFFFFFFF"/>
                        <Border x:Name="WeatherCityColorPreview" Grid.Column="1" Width="26" Height="26" CornerRadius="4" Background="#FFFFFFFF" HorizontalAlignment="Left" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="选择…" Click="PickWeatherCityColor_Click" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="天气信息颜色（天气描述、风、湿度）" FontSize="13" Margin="0,10,0,4"/>
                    <Grid ColumnDefinitions="90,*,Auto">
                        <TextBox x:Name="WeatherInfoColorBox" Grid.Column="0" Text="#FFCCCCDD"/>
                        <Border x:Name="WeatherInfoColorPreview" Grid.Column="1" Width="26" Height="26" CornerRadius="4" Background="#FFCCCCDD" HorizontalAlignment="Left" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="选择…" Click="PickWeatherInfoColor_Click" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="温度颜色" FontSize="13" Margin="0,10,0,4"/>
                    <Grid ColumnDefinitions="90,*,Auto">
                        <TextBox x:Name="WeatherTempColorBox" Grid.Column="0" Text="#FFFF8844"/>
                        <Border x:Name="WeatherTempColorPreview" Grid.Column="1" Width="26" Height="26" CornerRadius="4" Background="#FFFF8844" HorizontalAlignment="Left" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="选择…" Click="PickWeatherTempColor_Click" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="天气图标颜色" FontSize="13" Margin="0,10,0,4"/>
                    <Grid ColumnDefinitions="90,*,Auto">
                        <TextBox x:Name="WeatherIconColorBox" Grid.Column="0" Text="#FFFFAA00"/>
                        <Border x:Name="WeatherIconColorPreview" Grid.Column="1" Width="26" Height="26" CornerRadius="4" Background="#FFFFAA00" HorizontalAlignment="Left" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="选择…" Click="PickWeatherIconColor_Click" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="更新时间颜色" FontSize="13" Margin="0,10,0,4"/>
                    <Grid ColumnDefinitions="90,*,Auto">
                        <TextBox x:Name="WeatherTimeColorBox" Grid.Column="0" Text="#66AAAAAA"/>
                        <Border x:Name="WeatherTimeColorPreview" Grid.Column="1" Width="26" Height="26" CornerRadius="4" Background="#66AAAAAA" HorizontalAlignment="Left" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="选择…" Click="PickWeatherTimeColor_Click" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="其他选项" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid ColumnDefinitions="70,*,80" Margin="0,2,0,6">
                        <TextBlock Text="刷新间隔" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <Slider x:Name="WeatherRefreshIntervalSlider" ValueChanged="WeatherRefreshIntervalSlider_ValueChanged" Grid.Column="1" Minimum="0" Maximum="120" Value="30" TickFrequency="5" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="WeatherRefreshIntervalText" Grid.Column="2" Text="30分" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="0 = 不自动刷新；单位：分钟"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="70,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
