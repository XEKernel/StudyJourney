<UserControl x:Class="StudyJourney.Avalonia.Views.Settings.PositionPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="14" Margin="0,8,20,20">

            <!-- 屏幕位置预设 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="屏幕位置预设" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <RadioButton x:Name="PosTop" Content="顶部"/>
                    <RadioButton x:Name="PosUpperCenter" Content="中上（默认）" IsChecked="True" Margin="0,6,0,0"/>
                    <RadioButton x:Name="PosCenter" Content="居中" Margin="0,6,0,0"/>
                    <RadioButton x:Name="PosLowerCenter" Content="中下" Margin="0,6,0,0"/>
                    <RadioButton x:Name="PosBottom" Content="底部" Margin="0,6,0,0"/>
                    <RadioButton x:Name="PosCustom" Content="自定义坐标" Margin="0,8,0,0"/>

                    <StackPanel Margin="16,8,0,0" Opacity="0.55" IsEnabled="False">
                        <TextBlock Text="X 坐标（像素；-1 = 水平居中）" FontSize="13"/>
                        <TextBox x:Name="CustomXBox" Text="-1" Width="130" Margin="0,4,0,0"/>
                        <TextBlock Text="Y 坐标（像素；-1 = 自动）" FontSize="13" Margin="0,8,0,0"/>
                        <TextBox x:Name="CustomYBox" Text="-1" Width="130" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 微调 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="微调" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="垂直偏移像素（负值=上移，正值=下移）" FontSize="13" Margin="0,0,0,4"/>
                    <TextBox x:Name="OffsetYBox" Text="0" Width="90"/>
                </StackPanel>
            </Border>

            <!-- 窗口层级 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="窗口层级" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="AlwaysOnTopCheck" Content="始终置顶（覆盖在其他窗口上方）" IsChecked="True"/>
                    <TextBlock Text="关闭后窗口位于桌面壁纸上方、其他窗口下方"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="24,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 系统 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="🚀  系统" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="AutoStartCheck" Content="开机自动启动"/>
                    <TextBlock Text="写入当前用户注册表 Run 键，无需管理员权限。&#10;若程序路径发生变化（如移动文件夹），请重新勾选一次。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="24,0,0,8" TextWrapping="Wrap"/>
                    <CheckBox x:Name="HideWhenMaximizedCheck" Content="其他应用最大化时自动隐藏" Margin="0,6,0,0"/>
                    <CheckBox x:Name="HideDuringClassCheck" Content="上课/考试时自动隐藏倒计时窗口" Margin="0,8,0,0"/>
                    <TextBlock Text="前台窗口最大化时自动隐藏倒计时，恢复时重新显示。&#10;不影响托盘右键显示/隐藏功能。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="24,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="仅对以下科目隐藏（逗号分隔，留空则全部隐藏）" FontSize="13" Margin="0,8,0,2"/>
                    <TextBox x:Name="HideSubjectsBox" Width="220" Watermark="数学,物理,英语"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
