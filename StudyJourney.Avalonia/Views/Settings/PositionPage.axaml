<UserControl x:Class="StudyJourney.Avalonia.Views.Settings.PositionPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia">
    <ScrollViewer>
        <StackPanel Margin="0,8,16,16">

            <!-- 位置预设（WinUI 3 RadioButtons 组） -->
            <Border CornerRadius="8" Background="#14FFFFFF" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="窗口位置" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="选择主窗口在屏幕上的预设位置" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <StackPanel Margin="0,12,0,0">
                        <RadioButton Content="顶部" IsChecked="True"/>
                        <RadioButton Content="中上"/>
                        <RadioButton Content="居中"/>
                        <RadioButton Content="中下"/>
                        <RadioButton Content="底部"/>
                        <RadioButton Content="自定义位置（拖动窗口调整）"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 高级 -->
            <Border CornerRadius="8" Background="#14FFFFFF" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="窗口行为" FontSize="16" FontWeight="SemiBold"/>

                    <StackPanel Margin="0,10,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="总在最前" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="True"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="自定义位置时点击穿透" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="True"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <TextBlock Text="垂直偏移（像素）" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="0" Width="120"
                                     HorizontalContentAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
