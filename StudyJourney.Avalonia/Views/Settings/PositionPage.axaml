<UserControl x:Class="StudyJourney.Avalonia.Views.Settings.PositionPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="14" Margin="0,8,20,20">

            <!-- 灵动岛外观 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="灵动岛外观" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBlock Text="胶囊样式" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                    <RadioButton x:Name="CapsuleMerged" Content="单条大胶囊（所有内容合并一块）" IsCheckedChanged="MarkDirty_Changed"/>
                    <RadioButton x:Name="CapsuleSeparated" Content="多块胶囊（每块独立，可自定义布局）" Margin="0,6,0,0" IsCheckedChanged="MarkDirty_Changed"/>

                    <Grid ColumnDefinitions="110,*,70" Margin="0,14,0,4">
                        <TextBlock Text="胶囊圆角" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <Slider x:Name="CornerRadiusSlider" Grid.Column="1" Minimum="0" Maximum="20" Value="12"
                                TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="CornerRadiusSlider_ValueChanged"/>
                        <TextBlock x:Name="CornerRadiusText" Grid.Column="2" Text="12" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="0=直角，20=完全胶囊。圆角对两种胶囊样式同时生效。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <CheckBox x:Name="CountdownBarCheck" Content="倒计时进度条用条形（默认环形，进度数字在环旁）" Margin="0,10,0,0" IsCheckedChanged="MarkDirty_Changed"/>

                </StackPanel>
            </Border>

            <!-- 屏幕位置预设 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="屏幕位置预设" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <RadioButton x:Name="PosTop" GroupName="PosPreset" Content="顶部" IsCheckedChanged="MarkDirty_Changed"/>
                    <RadioButton x:Name="PosUpperCenter" GroupName="PosPreset" Content="中上（默认）" IsChecked="True" Margin="0,6,0,0" IsCheckedChanged="MarkDirty_Changed"/>
                    <RadioButton x:Name="PosCenter" GroupName="PosPreset" Content="居中" Margin="0,6,0,0" IsCheckedChanged="MarkDirty_Changed"/>
                    <RadioButton x:Name="PosLowerCenter" GroupName="PosPreset" Content="中下" Margin="0,6,0,0" IsCheckedChanged="MarkDirty_Changed"/>
                    <RadioButton x:Name="PosBottom" GroupName="PosPreset" Content="底部" Margin="0,6,0,0" IsCheckedChanged="MarkDirty_Changed"/>
                    <RadioButton x:Name="PosCustom" GroupName="PosPreset" Content="自定义坐标" Margin="0,8,0,0"
                                IsCheckedChanged="MarkDirty_Changed"/>

                    <!-- 高级定位（v2.21.0：原两块面板常驻 —— 老师看到"X 坐标（像素）"无从下手。
                         拖动定位才是主交互：选「自定义坐标」后直接拖窗口即可，数字框只做精调兜底） -->
                    <Expander Header="高级定位（一般不用改 —— 选「自定义坐标」后直接拖动窗口即可）"
                              FontSize="13" IsExpanded="False" Margin="0,10,0,0">
                        <StackPanel Spacing="10" Margin="0,8,0,4">
                            <Grid ColumnDefinitions="170,120,20,170,120">
                                <TextBlock Text="X 坐标（-1 = 水平居中）" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <NumericUpDown Grid.Column="1" x:Name="CustomXBox" Minimum="-99999" Maximum="99999"
                                               Increment="1" FormatString="0" ValueChanged="PosBox_ValueChanged"/>
                                <TextBlock Grid.Column="3" Text="Y 坐标（-1 = 自动）" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <NumericUpDown Grid.Column="4" x:Name="CustomYBox" Minimum="-99999" Maximum="99999"
                                               Increment="1" FormatString="0" ValueChanged="PosBox_ValueChanged"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="CenterPosBtn" Content="恢复居中" Click="CenterPosBtn_Click"/>
                                <TextBlock Text="把 X/Y 恢复为默认（水平居中、高度自动）" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- ⚠ 范围必须宽到"实际不可达"：NumericUpDown 加载时会静默夹取越界值，
                                 随后 Apply 就把它落盘了 —— 等于悄悄改掉老师的设置 -->
                            <Grid ColumnDefinitions="170,120,20,170,120">
                                <TextBlock Text="水平偏移（负=左移）" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <NumericUpDown Grid.Column="1" x:Name="OffsetXBox" Minimum="-9999" Maximum="9999"
                                               Increment="1" FormatString="0" ValueChanged="PosBox_ValueChanged"/>
                                <TextBlock Grid.Column="3" Text="垂直偏移（负=上移）" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <NumericUpDown Grid.Column="4" x:Name="OffsetYBox" Minimum="-9999" Maximum="9999"
                                               Increment="1" FormatString="0" ValueChanged="PosBox_ValueChanged"/>
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- 窗口行为（v2.22.0：原来叫「窗口层级」，两个置顶开关的文案看不出"管的是两个不同状态"） -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="窗口行为" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="下面两项互不影响：一项管「完整视图」，一项只管「上课时的进度条」。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,4"/>

                    <CheckBox x:Name="AlwaysOnTopCheck" Content="完整视图：压在其他窗口上方"
                              IsChecked="True" IsCheckedChanged="MarkDirty_Changed"/>
                    <TextBlock Text="关掉它，倒计时就贴在桌面壁纸上方、会被其他窗口盖住（上课时看不到，下课回到桌面才露出）。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="24,0,0,0" TextWrapping="Wrap"/>

                    <CheckBox x:Name="CompactTopmostCheck" Content="上课收起成进度条时：也压在窗口上方"
                              Margin="0,10,0,0" IsCheckedChanged="MarkDirty_Changed"/>
                    <TextBlock Text="只影响上课期间那条细进度条（此时完整视图本来就不显示）。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="24,0,0,0" TextWrapping="Wrap"/>

                    <CheckBox x:Name="ClickThroughCheck" Content="点击穿透（鼠标点不到窗口上）"
                              Margin="0,10,0,0" IsCheckedChanged="MarkDirty_Changed"/>
                    <TextBlock Text="开启后点窗口会点到后面的程序；自定义坐标模式下窗口始终可以拖动，不受此项影响。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="24,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 系统 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="🚀  系统" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="AutoStartCheck" Content="开机自动启动" IsCheckedChanged="MarkDirty_Changed"/>
                    <TextBlock Text="写入当前用户注册表 Run 键，无需管理员权限。&#10;若程序路径发生变化（如移动文件夹），请重新勾选一次。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="24,0,0,8" TextWrapping="Wrap"/>
                    <CheckBox x:Name="HideWhenMaximizedCheck" Content="有其他窗口时自动隐藏（桌面同一层）" Margin="0,6,0,0" IsCheckedChanged="MarkDirty_Changed"/>
                    <TextBlock Text="桌面有应用窗口时自动隐藏倒计时，回到纯桌面时重新显示。&#10;开启「始终置顶」后此隐藏不生效。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="24,0,0,4" TextWrapping="Wrap"/>
                    <CheckBox x:Name="HideDuringClassCheck" Content="上课时收起为进度条" Margin="0,8,0,0" IsCheckedChanged="MarkDirty_Changed"/>
                    <TextBlock Text="上课期间整栏收起，只保留一条进度条和当前课进度；下课后自动展开。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="24,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
