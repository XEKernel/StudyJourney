<UserControl x:Class="StudyJourney.Avalonia.Views.Settings.CountdownPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:StudyJourney.Avalonia.Views"
             x:CompileBindings="False">
    <ScrollViewer>
        <StackPanel Spacing="14" Margin="0,8,20,20">

            <!-- 字体与字号 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="字体与字号" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ComboBox x:Name="FontFamilyBox"/>
                    <Grid ColumnDefinitions="*,56" Margin="0,6,0,0">
                        <Slider x:Name="FontSizeSlider" ValueChanged="FontSizeSlider_ValueChanged" Minimum="8" Maximum="24" Value="12" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="FontSizeText" Grid.Column="1" Text="12" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 窗口透明度 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="窗口透明度" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid ColumnDefinitions="*,56">
                        <Slider x:Name="OpacitySlider" ValueChanged="OpacitySlider_ValueChanged" Minimum="0.1" Maximum="1.0" Value="1.0" TickFrequency="0.05"/>
                        <TextBlock x:Name="OpacityText" Grid.Column="1" Text="100%" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 配色方案 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="配色方案" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <v:ColorSwatch x:Name="TextColorSwatch" Caption="文字颜色（倒计时文字）"/>
                    <v:ColorSwatch x:Name="AccentColorSwatch" Caption="强调色（进度条 / 圆环 / 课表高亮）"
                                   Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 可见内容 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="可见内容" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ShowProgressBarCheck" Content="显示进度条" IsChecked="True"/>
                    <CheckBox x:Name="ShowProgressTextCheck" Content="显示进度百分比文字" IsChecked="True" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 时间精度 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="时间精度 · 显示哪些单位" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="隐藏某一单位后，该数字与标签均不显示；至少保留一项以防页面空白。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <CheckBox x:Name="ShowDaysCheck" Content="📅  天（Days）" IsChecked="True"/>
                    <CheckBox x:Name="ShowHoursCheck" Content="⏰  小时（Hours）" IsChecked="True" Margin="0,6,0,0"/>
                    <CheckBox x:Name="ShowMinutesCheck" Content="⏱  分钟（Minutes）" IsChecked="True" Margin="0,6,0,0"/>
                    <CheckBox x:Name="ShowSecondsCheck" Content="⌛  秒（Seconds）" IsChecked="True" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 目标日期（2026-09-25：原来要手打 yyyy-MM-dd HH:mm:ss → 改为日期 + 时刻选择器） -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="目标考试日期" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="点日期框选日历，旁边选时刻；倒计时在那一刻清零。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <DatePicker x:Name="GaokaoDatePicker" Width="180" SelectedDateChanged="GaokaoDateChanged"/>
                        <TimePicker x:Name="GaokaoTimePicker" Width="130"
                                    ClockIdentifier="24HourClock" MinuteIncrement="5"
                                    SelectedTimeChanged="GaokaoTimeChanged"/>
                        <Button Content="清除" Click="ClearGaokaoDate_Click" VerticalAlignment="Center"
                                ToolTip.Tip="清空后不显示高考倒计时"/>
                    </StackPanel>
                    <TextBlock x:Name="GaokaoDateHintTb" Text="" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 起算日期 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="进度条起算日期" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="进度条从这一天算起，到目标日期为 100%。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <DatePicker x:Name="StartDatePicker" Width="180" SelectedDateChanged="StartDateChanged"/>
                        <Button Content="清除" Click="ClearStartDate_Click" VerticalAlignment="Center"
                                ToolTip.Tip="清空后进度条按默认区间估算"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 自定义倒计时（2026-09-25：表格手打日期 → 行内日期选择器） -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="📅  自定义倒计时" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="例如「期末考试」「运动会」。改完点窗口下方「保存设置」生效。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="CountdownListPanel" Spacing="6"/>
                    </ScrollViewer>
                    <TextBlock x:Name="CountdownEmptyTb" Text="（还没有自定义倒计时）" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Button x:Name="AddCountdownBtn" Content="＋ 添加" Click="AddCountdownBtn_Click"
                            HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
