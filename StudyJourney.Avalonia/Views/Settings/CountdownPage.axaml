<UserControl x:Class="StudyJourney.Avalonia.Views.Settings.CountdownPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:StudyJourney.Avalonia.Views"
             xmlns:vm="using:StudyJourney.Avalonia.ViewModels.Settings"
             x:DataType="vm:CountdownPageViewModel">
    <!--
        2026-10-06 MVVM 化：原来是 x:CompileBindings="False"（反射绑定，AOT 下不可用）+ 满屏 x:Name，
        现在改成 x:DataType + 编译绑定，code-behind 只剩「系统字体列表填充」和「色板双向同步」两件视图专属的事。
        ⚠ DataContext 由 SettingsWindow 在 Load 时赋值（页面自己 new VM，避免每次切页都丢未保存状态）。
    -->
    <ScrollViewer>
        <StackPanel Spacing="14" Margin="0,8,20,20">

            <!-- 字体与字号 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="字体与字号" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ComboBox x:Name="FontFamilyBox" SelectedItem="{Binding FontFamily}"/>
                    <Grid ColumnDefinitions="*,56" Margin="0,6,0,0">
                        <Slider Value="{Binding FontSize}" Minimum="8" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="1" Text="{Binding FontSizeText}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 窗口透明度 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="窗口透明度" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid ColumnDefinitions="*,56">
                        <Slider Value="{Binding OverallOpacity}" Minimum="0.1" Maximum="1.0" TickFrequency="0.05"/>
                        <TextBlock Grid.Column="1" Text="{Binding OpacityText}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 配色方案 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="配色方案" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <!-- x:Name 保留：色板的「用户改色」上行通道要在 code-behind 里挂 ValueChanged
                         （ColorSwatch 的 ValueChanged 只在用户点色板时触发，赋 Value 不触发） -->
                    <v:ColorSwatch x:Name="TextColorSwatch" Caption="文字颜色（倒计时文字）" Value="{Binding TextColorHex}"/>
                    <v:ColorSwatch x:Name="AccentColorSwatch" Caption="强调色（进度条 / 圆环 / 课表高亮）"
                                   Margin="0,6,0,0" Value="{Binding AccentColorHex}"/>
                </StackPanel>
            </Border>

            <!-- 可见内容 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="可见内容" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox Content="显示进度条" IsChecked="{Binding ShowProgressBar}"/>
                    <CheckBox Content="显示进度百分比文字" IsChecked="{Binding ShowProgressText}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 时间精度 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="时间精度 · 显示哪些单位" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="隐藏某一单位后，该数字与标签均不显示；至少保留一项以防页面空白。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <CheckBox Content="📅  天（Days）" IsChecked="{Binding ShowDays}"/>
                    <CheckBox Content="⏰  小时（Hours）" IsChecked="{Binding ShowHours}" Margin="0,6,0,0"/>
                    <CheckBox Content="⏱  分钟（Minutes）" IsChecked="{Binding ShowMinutes}" Margin="0,6,0,0"/>
                    <CheckBox Content="⌛  秒（Seconds）" IsChecked="{Binding ShowSeconds}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 目标考试日期（2026-09-25：原来要手打 yyyy-MM-dd HH:mm:ss → 改为日期 + 时刻选择器） -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="目标考试日期" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="点日期框选日历，旁边选时刻；倒计时在那一刻清零。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <DatePicker Width="180" SelectedDate="{Binding GaokaoDate}"/>
                        <TimePicker Width="130" SelectedTime="{Binding GaokaoTime}"
                                    ClockIdentifier="24HourClock" MinuteIncrement="5"/>
                        <Button Content="清除" Command="{Binding ClearGaokaoDateCommand}" VerticalAlignment="Center"
                                ToolTip.Tip="清空后不显示高考倒计时"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DateHintText}" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 起算日期 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="进度条起算日期" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="进度条从这一天算起，到目标日期为 100%。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <DatePicker Width="180" SelectedDate="{Binding StartDate}"/>
                        <Button Content="清除" Command="{Binding ClearStartDateCommand}" VerticalAlignment="Center"
                                ToolTip.Tip="清空后进度条按默认区间估算"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 自定义倒计时（2026-10-06：由命令式全量重建面板改为 ItemsControl + ObservableCollection） -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="📅  自定义倒计时" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="例如「期末考试」「运动会」。改完点窗口下方「保存设置」生效。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Countdowns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CountdownItemViewModel">
                                    <Grid ColumnDefinitions="*,184,40">
                                        <TextBox Text="{Binding Name}" FontSize="13" MinHeight="34"
                                                 PlaceholderText="名称"
                                                 VerticalContentAlignment="Center"/>
                                        <DatePicker Grid.Column="1" SelectedDate="{Binding DateOffset}"
                                                    FontSize="13" MinHeight="34" Margin="8,0,0,0"/>
                                        <Button Grid.Column="2" Content="✕" FontSize="11" Padding="6,0"
                                                MinHeight="34" Margin="8,0,0,0"
                                                Command="{Binding DeleteCommand}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="（还没有自定义倒计时）" FontSize="12"
                               IsVisible="{Binding IsCountdownListEmpty}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Button Content="＋ 添加" Command="{Binding AddCountdownCommand}"
                            HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
