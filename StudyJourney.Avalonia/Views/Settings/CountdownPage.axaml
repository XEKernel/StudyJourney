<UserControl x:Class="StudyJourney.Avalonia.Views.Settings.CountdownPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dg="using:Avalonia.Controls"
             x:CompileBindings="False">
    <ScrollViewer>
        <StackPanel Spacing="14" Margin="0,8,20,20">

            <!-- 字体与字号 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="字体与字号" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ComboBox x:Name="FontFamilyBox"/>
                    <Grid ColumnDefinitions="*,56" Margin="0,6,0,0">
                        <Slider x:Name="FontSizeSlider" ValueChanged="FontSizeSlider_ValueChanged" Minimum="8" Maximum="24" Value="12" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="FontSizeText" Grid.Column="1" Text="12" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 窗口透明度 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="窗口透明度" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid ColumnDefinitions="*,56">
                        <Slider x:Name="OpacitySlider" ValueChanged="OpacitySlider_ValueChanged" Minimum="0.1" Maximum="1.0" Value="1.0" TickFrequency="0.05"/>
                        <TextBlock x:Name="OpacityText" Grid.Column="1" Text="100%" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 配色方案 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="配色方案" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="文字颜色（倒计时文字）" FontSize="13" Margin="0,4,0,4"/>
                    <Grid ColumnDefinitions="90,*,Auto">
                        <TextBox Grid.Column="0" x:Name="TextColorBox" Text="#FFFFFFFF"/>
                        <Border Grid.Column="1" x:Name="TextColorPreview" Width="26" Height="26" CornerRadius="4" Background="#FFFFFFFF"
                                HorizontalAlignment="Left" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="选择…" Margin="8,0,0,0" Click="PickTextColor_Click"/>
                    </Grid>
                    <TextBlock Text="强调色（进度条 / 圆环 / 课表高亮）" FontSize="13" Margin="0,10,0,4"/>
                    <Grid ColumnDefinitions="90,*,Auto">
                        <TextBox Grid.Column="0" x:Name="AccentColorBox" Text="#FF2B6CB0"/>
                        <Border Grid.Column="1" x:Name="AccentColorPreview" Width="26" Height="26" CornerRadius="4" Background="#FF2B6CB0"
                                HorizontalAlignment="Left" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="选择…" Margin="8,0,0,0" Click="PickAccentColor_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 可见内容 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="可见内容" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ShowProgressBarCheck" Content="显示进度条" IsChecked="True"/>
                    <CheckBox x:Name="ShowProgressTextCheck" Content="显示进度百分比文字" IsChecked="True" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 时间精度 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="时间精度 · 显示哪些单位" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="隐藏某一单位后，该数字与标签均不显示；至少保留一项以防页面空白。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <CheckBox x:Name="ShowDaysCheck" Content="📅  天（Days）" IsChecked="True"/>
                    <CheckBox x:Name="ShowHoursCheck" Content="⏰  小时（Hours）" IsChecked="True" Margin="0,6,0,0"/>
                    <CheckBox x:Name="ShowMinutesCheck" Content="⏱  分钟（Minutes）" IsChecked="True" Margin="0,6,0,0"/>
                    <CheckBox x:Name="ShowSecondsCheck" Content="⌛  秒（Seconds）" IsChecked="True" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 目标日期 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="目标考试日期" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="格式：yyyy-MM-dd HH:mm:ss  （例：2027-06-07 09:00:00）"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBox x:Name="GaokaoDateBox" Text="2027-06-07 09:00:00"/>
                </StackPanel>
            </Border>

            <!-- 起算日期 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="进度条起算日期" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="格式：yyyy-MM-dd  （例：2024-08-24）"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBox x:Name="StartDateBox" Text="2024-08-24"/>
                </StackPanel>
            </Border>

            <!-- 自定义倒计时 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="📅  自定义倒计时" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <dg:DataGrid x:Name="CustomCountdownGrid" Height="140" AutoGenerateColumns="False"
                                 IsReadOnly="False" GridLinesVisibility="Horizontal">
                        <dg:DataGrid.Columns>
                            <dg:DataGridTextColumn Header="名称" Width="150" Binding="{Binding Name}"/>
                            <dg:DataGridTextColumn Header="日期" Width="*" Binding="{Binding DateStr}"/>
                        </dg:DataGrid.Columns>
                    </dg:DataGrid>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                        <Button x:Name="AddCountdownBtn" Content="＋ 添加" Click="AddCountdownBtn_Click"/>
                        <Button x:Name="DeleteCountdownBtn" Content="－ 删除" Click="DeleteCountdownBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
