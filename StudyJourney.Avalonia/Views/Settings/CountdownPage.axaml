<UserControl x:Class="StudyJourney.Avalonia.Views.Settings.CountdownPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dg="using:Avalonia.Controls"
             x:CompileBindings="False">
    <ScrollViewer>
        <StackPanel Spacing="14" Margin="0,8,20,20">

            <!-- 字体与字号 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="字体与字号" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ComboBox SelectedIndex="0">
                        <ComboBoxItem Content="默认字体"/>
                        <ComboBoxItem Content="微软雅黑"/>
                        <ComboBoxItem Content="宋体"/>
                        <ComboBoxItem Content="黑体"/>
                    </ComboBox>
                    <Grid ColumnDefinitions="*,56" Margin="0,6,0,0">
                        <Slider x:Name="FontSizeSlider" Minimum="16" Maximum="72" Value="40" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="FontSizeText" Grid.Column="1" Text="40" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 窗口透明度 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="窗口透明度" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid ColumnDefinitions="*,56">
                        <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1.0" Value="1.0" TickFrequency="0.05"/>
                        <TextBlock x:Name="OpacityText" Grid.Column="1" Text="100%" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 配色方案 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="配色方案" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="数字颜色（天 / 时 / 分 / 秒）" FontSize="13" Margin="0,4,0,4"/>
                    <Grid ColumnDefinitions="90,*,Auto">
                        <TextBox Grid.Column="0" Text="#FF2B6CB0"/>
                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="4" Background="#FF2B6CB0"
                                HorizontalAlignment="Left" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="选择…" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="文字颜色（标签 / 说明）" FontSize="13" Margin="0,10,0,4"/>
                    <Grid ColumnDefinitions="90,*,Auto">
                        <TextBox Grid.Column="0" Text="#FFFFFFFF"/>
                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="4" Background="#FFFFFFFF"
                                HorizontalAlignment="Left" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="选择…" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="进度条颜色" FontSize="13" Margin="0,10,0,4"/>
                    <Grid ColumnDefinitions="90,*,Auto">
                        <TextBox Grid.Column="0" Text="#FF4CAF50"/>
                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="4" Background="#FF4CAF50"
                                HorizontalAlignment="Left" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="选择…" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 可见内容 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="可见内容" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ShowEnglishCheck" Content="显示英文倒计时行" IsChecked="True"/>
                    <CheckBox x:Name="ShowProgressBarCheck" Content="显示进度条" IsChecked="True" Margin="0,6,0,0"/>
                    <CheckBox x:Name="ShowProgressTextCheck" Content="显示进度百分比文字" IsChecked="True" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 时间精度 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="时间精度 · 显示哪些单位" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="隐藏某一单位后，该数字与标签均不显示；至少保留一项以防页面空白。"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <CheckBox x:Name="ShowDaysCheck" Content="📅  天（Days）" IsChecked="True"/>
                    <CheckBox x:Name="ShowHoursCheck" Content="⏰  小时（Hours）" IsChecked="True" Margin="0,6,0,0"/>
                    <CheckBox x:Name="ShowMinutesCheck" Content="⏱  分钟（Minutes）" IsChecked="True" Margin="0,6,0,0"/>
                    <CheckBox x:Name="ShowSecondsCheck" Content="⌛  秒（Seconds）" IsChecked="True" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 进度百分比精度 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="进度百分比精度" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="小数位数（0 ～ 10）" FontSize="13"/>
                    <Grid ColumnDefinitions="*,56" Margin="0,6,0,0">
                        <Slider x:Name="DecimalSlider" Minimum="0" Maximum="10" Value="7" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="DecimalText" Grid.Column="1" Text="7" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 动画 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="动画" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="EnableAnimationsCheck" Content="启用数字脉冲动画 &amp; 进度条平滑过渡" IsChecked="True"/>
                    <TextBlock Text="关闭后数字每秒直接更新，进度条直接跳转，性能更节省"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="24,0,0,6" TextWrapping="Wrap"/>
                    <CheckBox Content="启用设置窗口 Tab 切换滑动动画" IsChecked="True" Margin="0,6,0,0"/>
                    <TextBlock Text="关闭后 Tab 切换直接显示，无过渡效果"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="24,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 目标日期 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="目标考试日期" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="格式：yyyy-MM-dd HH:mm:ss  （例：2027-06-07 09:00:00）"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBox x:Name="GaokaoDateBox" Text="2027-06-07 09:00:00"/>
                </StackPanel>
            </Border>

            <!-- 起算日期 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="进度条起算日期" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="格式：yyyy-MM-dd  （例：2024-08-24）"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBox x:Name="StartDateBox" Text="2024-08-24"/>
                </StackPanel>
            </Border>

            <!-- 中文文本 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="中文文本" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="前缀" FontSize="13"/>
                    <TextBox Text="距离高考还有 "/>
                    <TextBlock Text="天 的后缀" FontSize="13" Margin="0,6,0,0"/>
                    <TextBox Text="天 "/>
                    <TextBlock Text="小时 的后缀" FontSize="13" Margin="0,6,0,0"/>
                    <TextBox Text="小时 "/>
                    <TextBlock Text="分 的后缀" FontSize="13" Margin="0,6,0,0"/>
                    <TextBox Text="分 "/>
                    <TextBlock Text="秒 的后缀" FontSize="13" Margin="0,6,0,0"/>
                    <TextBox Text="秒"/>
                </StackPanel>
            </Border>

            <!-- 英文文本 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="英文文本" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="前缀" FontSize="13"/>
                    <TextBox Text="There are "/>
                    <TextBlock Text="天（days）后缀" FontSize="13" Margin="0,6,0,0"/>
                    <TextBox Text=", days "/>
                    <TextBlock Text="小时（hours）后缀" FontSize="13" Margin="0,6,0,0"/>
                    <TextBox Text=", hours "/>
                    <TextBlock Text="分钟（minutes）后缀" FontSize="13" Margin="0,6,0,0"/>
                    <TextBox Text=", minutes, and "/>
                    <TextBlock Text="秒（seconds）后缀 / 结尾" FontSize="13" Margin="0,6,0,0"/>
                    <TextBox Text=" seconds."/>
                </StackPanel>
            </Border>

            <!-- 自定义倒计时 -->
            <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="📅  自定义倒计时" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <dg:DataGrid Height="140" AutoGenerateColumns="False"
                                 IsReadOnly="False" GridLinesVisibility="Horizontal">
                        <dg:DataGrid.Columns>
                            <dg:DataGridTextColumn Header="名称" Width="150" Binding="{Binding Name}"/>
                            <dg:DataGridTextColumn Header="日期" Width="*" Binding="{Binding DateStr}"/>
                        </dg:DataGrid.Columns>
                    </dg:DataGrid>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                        <Button Content="＋ 添加"/>
                        <Button Content="－ 删除"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
