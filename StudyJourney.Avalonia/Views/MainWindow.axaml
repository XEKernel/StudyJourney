<Window x:Class="StudyJourney.Avalonia.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="学程"
        WindowDecorations="None"
        TransparencyLevelHint="None"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        Opened="Window_Opened"
        PointerPressed="Window_PointerPressed">

    <!-- ClassIsland 风格顶栏：单条半透明深色胶囊，元素直接横向排列（无块中块），
         细竖线分隔；进度条紧跟科目下方 -->
    <Border CornerRadius="20"
            Background="#E6202020"
            BorderBrush="#14FFFFFF"
            BorderThickness="1"
            Padding="16,10,16,9"
            BoxShadow="0 3 12 1 #3A000000">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="进入考试模式" Click="ExamModeMenuItem_Click"/>
                <MenuItem Header="打开设置" Click="OpenSettingsMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="退出" Click="ExitMenuItem_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel Spacing="6">

            <!-- 主行：时间 | 天气 | 已上科目 ┃ 状态 ┃ 未来科目 | 倒计时圆环（单行，无块中块） -->
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">

                <TextBlock x:Name="TimeTb" Text="12:30:44" FontSize="15" FontWeight="SemiBold"
                           Foreground="#FFFFFFFF" FontFamily="Consolas" VerticalAlignment="Center"/>
                <Border Width="1" Height="16" Background="#2AFFFFFF" VerticalAlignment="Center"/>

                <TextBlock x:Name="WeatherTb" Text="☀ 18°C" FontSize="14"
                           Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                <Border Width="1" Height="16" Background="#2AFFFFFF" VerticalAlignment="Center"/>

                <TextBlock x:Name="PrevSubjectsTb" Text="语 数 美 历 英" FontSize="14"
                           Foreground="#E6FFFFFF" VerticalAlignment="Center"/>
                <Border Width="1" Height="16" Background="#2AFFFFFF" VerticalAlignment="Center"/>

                <TextBlock x:Name="StatusTb" Text="课间休息" FontSize="14" FontWeight="SemiBold"
                           Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                <Border Width="1" Height="16" Background="#2AFFFFFF" VerticalAlignment="Center"/>

                <TextBlock x:Name="NextSubjectsTb" Text="生 政 自 自" FontSize="14"
                           Foreground="#B0FFFFFF" VerticalAlignment="Center"/>
                <Border Width="1" Height="16" Background="#2AFFFFFF" VerticalAlignment="Center"/>

                <!-- 倒计时圆环（小圆环 + 文字，直接排进主行） -->
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="2,0,0,0" VerticalAlignment="Center">
                    <!-- 高考（固定，暗蓝圆环 + 学士帽 + 红色气泡） -->
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Grid Width="22" Height="22">
                            <Arc StartAngle="0" SweepAngle="360" Stroke="#24FFFFFF" StrokeThickness="3"/>
                            <Arc x:Name="GaokaoRingArc" StartAngle="-90" SweepAngle="0"
                                 Stroke="#FF2B6CB0" StrokeThickness="3" StrokeLineCap="Round"/>
                            <TextBlock Text="🎓" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Width="9" Height="9" CornerRadius="5" Background="#FFE53935"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0">
                                <TextBlock Text="6" FontSize="6" FontWeight="Bold" Foreground="#FFFFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="GaokaoTb" Text="高考 216天" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 自定义倒计时圆环（动态，来自设置页「自定义倒计时」） -->
                    <StackPanel x:Name="RingHost" Orientation="Horizontal" Spacing="14"/>
                </StackPanel>
            </StackPanel>

            <!-- 进度条：紧跟科目下方（上课进度 / 课间休息进度） -->
            <ProgressBar x:Name="ClassProgressBar" Height="3" Minimum="0" Maximum="100"
                         Foreground="#4DD0E1" Background="#22FFFFFF"/>
        </StackPanel>
    </Border>
</Window>
