<Window x:Class="StudyJourney.Avalonia.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="学程"
        WindowDecorations="None"
        TransparencyLevelHint="None"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        Opened="Window_Opened"
        PointerPressed="Window_PointerPressed">

    <!-- 桌面小组件：圆角卡片 + 倒计时 + 进度 + 一言（对齐学程 WPF 主窗口布局） -->
    <Border CornerRadius="12"
            Background="#F21A1A2E"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="20,14"
            BoxShadow="0 8 24 2 #66000000">
        <StackPanel Spacing="4">

            <!-- 中文倒计时行 -->
            <StackPanel x:Name="ChineseRow" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="ChinesePrefixTb" Text="距离高考还有 " FontSize="40" Foreground="#FFFFFFFF"/>
                <TextBlock x:Name="DaysTb" Text="0" FontSize="40" FontWeight="Bold" Foreground="#FF2B6CB0"/>
                <TextBlock x:Name="ChineseDaysTb" Text="天 " FontSize="40" Foreground="#FFFFFFFF"/>
                <TextBlock x:Name="HoursTb" Text="00" FontSize="40" FontWeight="Bold" Foreground="#FF2B6CB0"/>
                <TextBlock x:Name="ChineseHoursTb" Text="小时 " FontSize="40" Foreground="#FFFFFFFF"/>
                <TextBlock x:Name="MinutesTb" Text="00" FontSize="40" FontWeight="Bold" Foreground="#FF2B6CB0"/>
                <TextBlock x:Name="ChineseMinutesTb" Text="分 " FontSize="40" Foreground="#FFFFFFFF"/>
                <TextBlock x:Name="SecondsTb" Text="00" FontSize="40" FontWeight="Bold" Foreground="#FF2B6CB0"/>
                <TextBlock x:Name="ChineseSecondsTb" Text="秒" FontSize="40" Foreground="#FFFFFFFF"/>
            </StackPanel>

            <!-- 进度条 -->
            <ProgressBar x:Name="ProgressBar" Height="6" Minimum="0" Maximum="100" Margin="0,6,0,0"/>

            <!-- 中文进度文本 -->
            <TextBlock x:Name="ProgressText" FontSize="12" Foreground="#FFFFFFFF"
                       HorizontalAlignment="Center" Margin="0,2,0,0"/>

            <!-- 英文倒计时行 -->
            <StackPanel x:Name="EnglishRow" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="EnglishPrefixTb" Text="There are " FontSize="13" Foreground="#FFD3D3D3"/>
                <TextBlock x:Name="DaysEnTb" Text="0" FontSize="13" FontWeight="Bold" Foreground="#FF2B6CB0"/>
                <TextBlock x:Name="EnglishDaysTb" Text=", days " FontSize="13" Foreground="#FFD3D3D3"/>
                <TextBlock x:Name="HoursEnTb" Text="00" FontSize="13" FontWeight="Bold" Foreground="#FF2B6CB0"/>
                <TextBlock x:Name="EnglishHoursTb" Text=", hours " FontSize="13" Foreground="#FFD3D3D3"/>
                <TextBlock x:Name="MinutesEnTb" Text="00" FontSize="13" FontWeight="Bold" Foreground="#FF2B6CB0"/>
                <TextBlock x:Name="EnglishMinutesTb" Text=", minutes, and " FontSize="13" Foreground="#FFD3D3D3"/>
                <TextBlock x:Name="SecondsEnTb" Text="00" FontSize="13" FontWeight="Bold" Foreground="#FF2B6CB0"/>
                <TextBlock x:Name="EnglishSecondsTb" Text=" seconds." FontSize="13" Foreground="#FFD3D3D3"/>
            </StackPanel>

            <!-- 自定义倒计时 -->
            <TextBlock x:Name="CustomCountdownTb" FontSize="12" Foreground="#FFFFCC88"
                       HorizontalAlignment="Center" IsVisible="False"/>

            <!-- 每日一言 -->
            <TextBlock x:Name="DailyQuoteTb" FontSize="12" Foreground="#FFAAAAAA"
                       FontStyle="Italic" HorizontalAlignment="Center"
                       IsVisible="False" TextTrimming="CharacterEllipsis" MaxWidth="760"
                       Cursor="Hand" PointerPressed="DailyQuoteTb_PointerPressed"
                       ToolTip.Tip="点击刷新每日一言"/>

        </StackPanel>
    </Border>
</Window>
