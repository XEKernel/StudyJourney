<Window x:Class="StudyJourney.Avalonia.Views.DebugTimeWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="时间模拟 · 调试"
        Width="380" Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="22" Spacing="12">

        <TextBlock Text="⏱ 时间模拟（调试）" FontSize="18" FontWeight="Bold"/>
        <TextBlock x:Name="NowTb" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"/>
        <TextBlock Text="点击按钮跳到关键时刻，课表栏/提醒/上课隐藏会在 1 秒内自动刷新。"
                   FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>

        <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
            <Button Content="🕐 上课中" Click="JumpInClass_Click" Padding="10,8"/>
            <Button Grid.Column="1" Content="🔔 快下课" Click="JumpEndSoon_Click" Padding="10,8" Margin="10,0,0,0"/>
        </Grid>
        <Grid ColumnDefinitions="*,*">
            <Button Content="✅ 已下课" Click="JumpAfterClass_Click" Padding="10,8"/>
            <Button Grid.Column="1" Content="⏰ 快上课" Click="JumpNextSoon_Click" Padding="10,8" Margin="10,0,0,0"/>
        </Grid>
        <Grid ColumnDefinitions="*,*">
            <Button Content="📝 自定义偏移(分)" Click="CustomOffset_Click" Padding="10,8"/>
            <Button Grid.Column="1" Content="↩ 重置为实时" Click="ResetBtn_Click" Padding="10,8" Margin="10,0,0,0"/>
        </Grid>

        <TextBlock x:Name="HintTb" FontSize="12" Foreground="#FFCC8800" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
