<Window x:Class="StudyJourney.Avalonia.Views.ScheduleBarWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="课表栏"
        WindowDecorations="None"
        TransparencyLevelHint="None"
        Background="Transparent"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        Opened="Window_Opened">

    <!-- 课表悬浮栏：屏幕顶部横幅（对齐学程 WPF ScheduleBarWindow：完整/紧凑双模式）
         完整模式三区：左=时间日期 | 中=状态/进度/详情 | 右=天气（主次两行） -->
    <Border Background="#DD0D0D1A" CornerRadius="0,0,6,6" Padding="0,4,0,4">
      <Grid>

        <!-- ── 完整模式 ── -->
        <Grid x:Name="FullInfoRoot" ColumnDefinitions="Auto,*,Auto" Margin="12,3,12,3">

            <!-- 左：时间 + 日期 -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                <TextBlock x:Name="CurrentTimeTb" Text="00:00:00" FontSize="17" FontWeight="Bold"
                           Foreground="#FFFFFFFF" FontFamily="Consolas" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DateTb" Text="08月12日 周三" FontSize="10" Foreground="#AAFFFFFF"
                           HorizontalAlignment="Center" Margin="0,1,0,0"/>
            </StackPanel>

            <!-- 中：状态行 / 进度行 / 60 秒倒计时 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center">
                    <TextBlock x:Name="StatusTb" Text="课间休息" FontSize="14" FontWeight="SemiBold"
                               Foreground="#FFFF8844" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NextCountdownTb" Text="" FontSize="13" Foreground="#FFFF8844"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="4,0,4,0">
                    <ProgressBar x:Name="ProgressBar" Height="5" Minimum="0" Maximum="100"
                                 VerticalAlignment="Center" IsVisible="False"/>
                    <TextBlock x:Name="ProgressPctTb" Grid.Column="1" Text="" FontSize="11"
                               Foreground="#AAFFFFFF" Margin="10,0,0,0"
                               VerticalAlignment="Center" IsVisible="False"/>
                </Grid>
                <TextBlock x:Name="Countdown60Tb" Text="" FontSize="14" FontWeight="Bold"
                           Foreground="#FFFF4444" HorizontalAlignment="Center" IsVisible="False"/>
            </StackPanel>

            <!-- 右：天气（主行=图标+温度+描述，次行=风+湿度+城市） -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0" HorizontalAlignment="Right">
                <StackPanel x:Name="WeatherRow" Orientation="Horizontal" Spacing="8" IsVisible="False"
                            HorizontalAlignment="Right">
                    <TextBlock x:Name="WeatherIconTb" Text="☀️" FontSize="14"/>
                    <TextBlock x:Name="WeatherTempTb" Text="--°" FontSize="14" FontWeight="Bold"
                               Foreground="#FF88CCFF"/>
                    <TextBlock x:Name="WeatherTb" Text="" FontSize="11" Foreground="#FFCCCCDD"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="WeatherMetaRow" Orientation="Horizontal" Spacing="8" IsVisible="False"
                            HorizontalAlignment="Right" Margin="0,1,0,0">
                    <TextBlock x:Name="WeatherWindTb" Text="" FontSize="10" Foreground="#88CCCCDD"/>
                    <TextBlock x:Name="WeatherHumidityTb" Text="" FontSize="10" Foreground="#88CCCCDD"/>
                    <TextBlock x:Name="WeatherCityTb" Text="" FontSize="10" Foreground="#88FFFFFF"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ── 紧凑模式：状态 + 进度条 + 时间 + 展开（上课自动收缩） ── -->
        <Grid x:Name="CompactRow" IsVisible="False" Margin="12,3,12,3" ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock x:Name="CompactStatusTb" Grid.Column="0" Text="" FontSize="12"
                       Foreground="#AAFFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ProgressBar x:Name="CompactProgressBar" Grid.Column="1" Height="5" Minimum="0" Maximum="100"
                         VerticalAlignment="Center" IsVisible="False"/>
            <TextBlock x:Name="CompactTimeTb" Grid.Column="2" Text="" FontSize="11" Foreground="#88FFFFFF"
                       VerticalAlignment="Center" Margin="10,0,10,0" FontFamily="Consolas"/>
            <Button x:Name="ExpandBtn" Grid.Column="3" Content="⌄" FontSize="11" Padding="6,0"
                    IsVisible="False" Click="ExpandBtn_Click" ToolTip.Tip="展开课表栏"/>
        </Grid>
      </Grid>
    </Border>
</Window>
