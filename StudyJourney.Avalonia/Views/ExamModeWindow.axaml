<Window x:Class="StudyJourney.Avalonia.Views.ExamModeWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="考试模式"
        WindowDecorations="None"
        WindowState="Maximized"
        Background="#FF060B14"
        Topmost="True"
        ShowInTaskbar="True"
        KeyDown="Window_KeyDown"
        Opened="Window_Opened">

    <!-- 考试全屏倒计时（对齐学程 WPF ExamModeWindow） -->
    <Grid x:Name="MainGrid" RowDefinitions="Auto,*,Auto,Auto,Auto,*,Auto">

        <!-- 顶部提示行 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" x:Name="EscHintTb" Text="ESC 退出 · F11 全屏"
                       FontSize="12" Foreground="#88FFFFFF"
                       Margin="30,16,0,0"/>
            <TextBlock Grid.Column="1" x:Name="CurrentTimeTb" Text="00:00:00"
                       FontSize="20" FontFamily="Consolas" Foreground="#66FFFFFF"
                       Margin="0,16,30,0"/>
        </Grid>

        <!-- 考试名称 -->
        <TextBlock Grid.Row="1" x:Name="ExamNameTb" Text="考试名称"
                   FontSize="28" Foreground="#AAFFFFFF"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>

        <!-- 当前科目 -->
        <TextBlock Grid.Row="2" x:Name="SubjectTb" Text="语文"
                   FontSize="64" FontWeight="Bold" Foreground="#FFFFFFFF"
                   HorizontalAlignment="Center" Margin="0,0,0,6"/>

        <!-- 主倒计时 -->
        <TextBlock Grid.Row="3" x:Name="CountdownTb" Text="00:00:00"
                   FontSize="130" FontWeight="Bold" FontFamily="Consolas"
                   Foreground="#FFFFFFFF" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- 进度区 -->
        <Grid Grid.Row="4" Margin="100,0,100,24" RowDefinitions="Auto,Auto,Auto">
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14" Margin="0,0,0,8">
                <TextBlock x:Name="StartTimeTb" Text="09:00" FontSize="15" Foreground="#88FFFFFF"/>
                <TextBlock Text="—" FontSize="15" Foreground="#44FFFFFF"/>
                <TextBlock x:Name="EndTimeTb" Text="11:30" FontSize="15" Foreground="#88FFFFFF"/>
                <TextBlock x:Name="DurationTb" Text="共 150 分钟" FontSize="15" Foreground="#66FFFFFF"/>
            </StackPanel>
            <ProgressBar Grid.Row="1" x:Name="ProgressBar" Height="10" Minimum="0" Maximum="100"
                         Background="#22FFFFFF" Foreground="#FF5B9BD5"/>
            <TextBlock Grid.Row="2" x:Name="ProgressPctTb" Text=""
                       FontSize="13" Foreground="#66FFFFFF"
                       HorizontalAlignment="Right" Margin="0,4,0,0"/>
        </Grid>

        <!-- 下一场 + 警告 -->
        <StackPanel Grid.Row="5" HorizontalAlignment="Center" Spacing="14">
            <TextBlock x:Name="NextSubjectTb" Text="" FontSize="20" Foreground="#88FFFFFF"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="WarningTb" Text="距离结束还有 15 分钟，请注意检查答卷"
                       FontSize="18" FontWeight="Bold" Foreground="#FFFFCC88"
                       HorizontalAlignment="Center" IsVisible="False"/>
        </StackPanel>

        <!-- 底部退出按钮 -->
        <Button Grid.Row="6" x:Name="ExitBtn" Content="退出考试模式"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,24" Padding="32,10" FontSize="15"
                Click="ExitBtn_Click"/>
    </Grid>
</Window>
