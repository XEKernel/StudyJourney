<ui:FAAppWindow x:Class="StudyJourney.Avalonia.Views.SettingsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        Title="学程 · 设置"
        Width="900" Height="640"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="Mica"
        Background="Transparent">

    <!-- WinUI 3 风格设置窗口：Mica + NavigationView 左侧导航 -->
    <Grid RowDefinitions="Auto,*">

        <!-- 顶部标题（FAAppWindow 标题栏覆盖其上） -->
        <TextBlock Grid.Row="0" Text="设置"
                   FontSize="20" FontWeight="SemiBold"
                   Margin="24,6,0,0"
                   IsHitTestVisible="False"/>

        <ui:FANavigationView Grid.Row="1"
                             x:Name="NavView"
                             PaneDisplayMode="Left"
                             OpenPaneLength="220"
                             IsSettingsVisible="False"
                             IsBackButtonVisible="False"
                             ItemInvoked="NavView_ItemInvoked">
            <ui:FANavigationView.MenuItems>
                <ui:FANavigationViewItem Content="显示" Tag="display"> </ui:FANavigationViewItem>
                <ui:FANavigationViewItem Content="外观" Tag="appearance"> </ui:FANavigationViewItem>
                <ui:FANavigationViewItem Content="位置" Tag="position"> </ui:FANavigationViewItem>
                <ui:FANavigationViewItem Content="关于" Tag="about"> </ui:FANavigationViewItem>
            </ui:FANavigationView.MenuItems>

            <!-- 页面内容区 -->
            <Border x:Name="PageHost" Margin="8,0,0,0"/>
        </ui:FANavigationView>
    </Grid>
</ui:FAAppWindow>
