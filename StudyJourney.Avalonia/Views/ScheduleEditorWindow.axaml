<Window x:Class="StudyJourney.Avalonia.Views.ScheduleEditorWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dg="using:Avalonia.Controls"
        Title="编辑课表 / 考试"
        Width="780" Height="560"
        WindowStartupLocation="CenterOwner"
        TransparencyLevelHint="Mica"
        Background="Transparent"
        x:CompileBindings="False">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,8,0,12">
            <TextBlock Text="编辑课表 / 考试" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="直接编辑 schedule.json（课表条目与考试安排，保存后立即生效）"
                       FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        </StackPanel>

        <!-- TabControl：课表 / 考试 -->
        <TabControl Grid.Row="1">
            <!-- ── 课表 Tab ── -->
            <TabItem Header="课表">
                <Grid RowDefinitions="*,Auto">
                    <dg:DataGrid Grid.Row="0" x:Name="EntryGrid"
                                 AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                                 SelectionMode="Single">
                        <dg:DataGrid.Columns>
                            <dg:DataGridTextColumn Header="星期" Width="60" Binding="{Binding DayOfWeek}"/>
                            <dg:DataGridTextColumn Header="节次" Width="50" Binding="{Binding Period}"/>
                            <dg:DataGridTextColumn Header="科目" Width="*" Binding="{Binding Subject}"/>
                            <dg:DataGridTextColumn Header="开始" Width="70" Binding="{Binding StartTimeStr}"/>
                            <dg:DataGridTextColumn Header="结束" Width="70" Binding="{Binding EndTimeStr}"/>
                            <dg:DataGridTextColumn Header="类型" Width="90" Binding="{Binding Type}"/>
                        </dg:DataGrid.Columns>
                    </dg:DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="＋ 添加课程" Click="AddBtn_Click"/>
                        <Button Content="－ 删除选中" Click="DeleteBtn_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ── 考试 Tab（考试 + 科目日程两级编辑） ── -->
            <TabItem Header="考试">
                <Grid RowDefinitions="Auto,140,Auto,Auto,140,Auto" Margin="0,4,0,0">
                    <TextBlock Grid.Row="0" Text="考试列表（选中一场后，下方编辑其科目日程）"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,4"/>
                    <dg:DataGrid Grid.Row="1" x:Name="ExamGrid"
                                 AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                                 SelectionMode="Single" SelectionChanged="ExamGrid_SelectionChanged">
                        <dg:DataGrid.Columns>
                            <dg:DataGridTextColumn Header="考试名称" Width="*" Binding="{Binding Name}"/>
                            <dg:DataGridTextColumn Header="日期" Width="140" Binding="{Binding DateStr}"/>
                        </dg:DataGrid.Columns>
                    </dg:DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="＋ 添加考试" Click="AddExamBtn_Click"/>
                        <Button Content="－ 删除选中" Click="DeleteExamBtn_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,4">
                        <TextBlock Text="科目日程（开考/结束时间）" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Content="＋ 添加科目" Click="AddExamSubjectBtn_Click"/>
                        <Button Content="－ 删除科目" Click="DeleteExamSubjectBtn_Click"/>
                        <Button Content="保存考试" Classes="accent" Click="SaveExamsBtn_Click"/>
                    </StackPanel>
                    <dg:DataGrid Grid.Row="4" x:Name="ExamSubjectGrid"
                                 AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                                 SelectionMode="Single">
                        <dg:DataGrid.Columns>
                            <dg:DataGridTextColumn Header="科目名称" Width="*" Binding="{Binding Name}"/>
                            <dg:DataGridTextColumn Header="开考" Width="100" Binding="{Binding StartTimeStr}"/>
                            <dg:DataGridTextColumn Header="结束" Width="100" Binding="{Binding EndTimeStr}"/>
                        </dg:DataGrid.Columns>
                    </dg:DataGrid>
                    <TextBlock Grid.Row="5" x:Name="ExamStatusTb" Text="" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
            <!-- ── 周视图 · 调课 Tab ── -->
            <TabItem Header="周视图 · 调课">
                <Grid ColumnDefinitions="*,290" Margin="0,4,0,0">

                    <!-- 左：课程表网格（代码动态构建，单击格子选源/目标） -->
                    <Grid Grid.Column="0" RowDefinitions="Auto,*">
                        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,6">
                            <TextBlock x:Name="SwapSourceLb" Text="源：未选择" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="SwapTargetLb" Text="目标：未选择" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="SwapHintTb" Text="点击上方格子选源，再点一个格子选目标" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" x:Name="TimetableScroll"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                    </Grid>

                    <!-- 右：调课操作 + 时段模板 + 调休 -->
                    <StackPanel Grid.Column="1" Spacing="10" Margin="14,0,0,0">

                        <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="14,12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="调课操作" FontSize="14" FontWeight="SemiBold"/>
                                <Button Content="⇄  交换两节课" Click="SwapCoursesBtn_Click"/>
                                <Button Content="➜  移动课程" Click="MoveCourseBtn_Click"/>
                                <Button Content="👨‍🏫  代课" Click="SubstituteCourseBtn_Click"/>
                                <Button Content="✕  清除选择" Click="ClearSwapSelBtn_Click"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="14,12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="时段模板" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="定义每个时段的起止时间与类型，决定网格行" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                <ScrollViewer x:Name="TemplateHost" MaxHeight="190" VerticalScrollBarVisibility="Auto"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="＋ 时段" Click="AddTimeSlotBtn_Click"/>
                                    <Button Content="应用" Click="ApplyTemplateBtn_Click" ToolTip.Tip="用模板重建网格行"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="14,12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="调休顺延" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="Auto,*,Auto,*">
                                    <TextBlock Text="从" FontSize="12" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="AdjustFromDayCb" Grid.Column="1" Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="到" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <ComboBox x:Name="AdjustToDayCb" Grid.Column="3" Margin="6,0,0,0"/>
                                </Grid>
                                <Button Content="复制课程（调休）" Click="ShiftRestBtn_Click"/>
                            </StackPanel>
                        </Border>

                        <Button Content="保存课表网格" Classes="accent" Click="SaveScheduleBtn_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 底部操作 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="导入 JSON" Click="ImportJsonBtn_Click" ToolTip.Tip="从 JSON 文件导入课表（覆盖当前）"/>
            <Button Content="导出 JSON" Click="ExportJsonBtn_Click" ToolTip.Tip="将当前课表导出为 JSON 文件"/>
            <Button Content="备份数据" Click="BackupBtn_Click" ToolTip.Tip="备份 settings.json + schedule.json"/>
            <Button Content="恢复数据" Click="RestoreBtn_Click" ToolTip.Tip="从备份恢复数据文件"/>
            <Button Content="撤销修改" Click="CancelBtn_Click"/>
            <Button Content="保存到 schedule.json" Classes="accent" Click="SaveBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
