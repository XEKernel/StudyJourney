<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 清空 VS 全局 fallbackPackageFolders（C:\Program Files (x86)\NuGet\Config\ 里的
       Microsoft.VisualStudio.FallbackLocation.config 指向旧路径 D:\Visual Studio tools\NuGetPackages，
       VS 重装后该目录已不存在，会导致 dotnet build 报 MSB4018）。
       本项目所有包均在 ~/.nuget/packages 主缓存，无需 fallback。 -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
