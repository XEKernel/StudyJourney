<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 清空 VS 全局 fallbackPackageFolders（C:\Program Files (x86)\NuGet\Config\ 里的
       Microsoft.VisualStudio.FallbackLocation.config 指向旧路径 D:\Visual Studio tools\NuGetPackages，
       VS 重装后该目录已不存在，会导致 dotnet build 报 MSB4018）。
       本项目所有包均在 ~/.nuget/packages 主缓存，无需 fallback。 -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>

  <!-- 本机 api.nuget.org 会被网络拦截（302 到 nuget.azure.cn 后返回空 body），
       但 www.nuget.org 的 v2 打包端点可用，因此 PDFium 封装包走本地目录：
         curl -sL -o local-nupkg/Docnet.Core.2.6.0.nupkg \
           https://www.nuget.org/api/v2/package/Docnet.Core/2.6.0
       这里刻意**不写 <clear/>**，保留继承来的 nuget.org —— CI（GitHub Actions）网络正常，
       直接从 nuget.org 还原；本机则从 local-nupkg 命中。两边都能构建。 -->
  <packageSources>
    <add key="local-nupkg" value="./local-nupkg" />
  </packageSources>
</configuration>
