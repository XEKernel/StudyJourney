<Project Sdk="Microsoft.NET.Sdk">

  <!-- ── StudyJourney.App：宿主层 ────────────────────────────────────────────
       组合根 + 主窗壳 + 自检宿主 + 更新编排（C4 宿主层）。
       预算 ≤ 1,500 行。

       S10 起是 WinExe（入口 Program.cs：单实例 Mutex + 空主窗 + smoke 无窗模式）。
       M0 的组合根只装配 M0 需要的 5 件东西：日志 / 配置 / 注册表 / 事件总线 / 加载器。 -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>WinExe</OutputType>
    <RootNamespace>StudyJourney.App</RootNamespace>
    <!-- ⚠ 刻意沿用 v3.3.0 的程序集名（CORE_ARCHITECTURE §1.4.1 的唯一例外）。
         App 的**目录名**是 StudyJourney.App，但**产物名**保持 StudyJourneyAvalonia：
         改名会同时牵动 4 处（更新器的 AOT 判定硬编码了 StudyJourneyAvalonia.dll /
         .runtimeconfig.json、注册表启动项、桌面快捷方式、CI 资产名），
         而 M0–M3 阶段完全不需要付这个成本。
         改名的唯一合适时机 = v4.0.0 发版（X 位，判据③"必须人工操作才能升级"），届时单独立项。 -->
    <AssemblyName>StudyJourneyAvalonia</AssemblyName>
    <PublishTrimmed>false</PublishTrimmed>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 桌面目标只允许出现在 App 层：Core / Sdk 都不引 Avalonia.Desktop（§1.4）。 -->
    <ProjectReference Include="..\StudyJourney.Core\StudyJourney.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 托盘图标走 avares://（TrayIcon 的 Icon 只吃 WindowIcon，不吃 ico 路径）。 -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- 只给 App 的测试工程看 internal（smoke 入口与组合根要能被直接调用断言，不必起 GUI）。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="StudyJourney.App.Tests" />
  </ItemGroup>

</Project>
