<Window x:Class="GaokaoCountdown.DialogOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" WindowState="Maximized">
    <Grid Background="Transparent">
        <ContentControl x:Name="ContentHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Focusable="True" RenderTransformOrigin="0.5,0.5">
            <ContentControl.RenderTransform>
                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
            </ContentControl.RenderTransform>
        </ContentControl>
    </Grid>
</Window>
