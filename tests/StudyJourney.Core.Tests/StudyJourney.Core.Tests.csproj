<Project Sdk="Microsoft.NET.Sdk">

  <!-- ── StudyJourney.Core.Tests ────────────────────────────────────────────
       被测对象：StudyJourney.Core。
       命名与 TFM 约定见 CORE_ARCHITECTURE §1.4.2：
         · TFM 与被测对象一致（net10.0），**不使用 net10.0-windows**
         · 不引用 Avalonia.Desktop / Avalonia.Themes.*（只要类型，不要桌面）
         · 断言"Core 不依赖桌面层"这件事本身，需要测试项目自己也不带桌面目标

       测试框架：xUnit v2（不是 v3）。 -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>StudyJourney.Core.Tests</RootNamespace>
    <AssemblyName>StudyJourney.Core.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StudyJourney.Core\StudyJourney.Core.csproj" />
    <!-- A0-15 探针夹具：为了"先构建、再加载"，这里加引用；代码里不使用它的任何类型，
         所以它不会被默认 ALC 提前加载（否则类型身份测试就没有意义了）。 -->
    <ProjectReference Include="..\fixtures\A0_15_Probe\A0_15_Probe.csproj" />
    <!-- S10 加载器失败分支夹具（InitFailed/StartFailed/回滚）。同样只为构建顺序与 dll 落盘。 -->
    <ProjectReference Include="..\fixtures\FailingPlugin\FailingPlugin.csproj" />
    <!-- S11：M0 的最小真插件。测试把它复制成临时 plugins/test/ 再走完整加载链路，
         代码里不使用它的类型（保持"默认 ALC 不提前加载"这个前提）。 -->
    <ProjectReference Include="..\..\plugins\Test\Test.csproj" />
  </ItemGroup>

</Project>
