<Project Sdk="Microsoft.NET.Sdk">

  <!-- ── StudyJourney.Plugins.Tests ─────────────────────────────────────────
       被测对象：plugins/Countdown 与 plugins/Schedule 的**纯逻辑部分**。

       为什么合成一个测试工程而不是每个插件各一个：
         · 插件的可测逻辑（日期换算、调休、配置解析、课表查询）跟 UI 无关，
           放一起能一次 `dotnet test` 跑完，也不必每加一个插件就动 sln；
         · 真正需要独立进程的（ALC 加载链路）已由 Core.Tests 覆盖，不在这里重复。

       ⚠ 测试工程在 tests/ 下，**不受 plugins/Directory.Build.targets 的边界断言约束**
         （那条 target 只作用于 plugins/ 子树）。所以这里可以同时引两个插件工程。
         插件工程自身仍然只能引 Sdk —— 这条不受影响。

       测试框架：xUnit v2（与其它测试工程一致）。 -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>StudyJourney.Plugins.Tests</RootNamespace>
    <AssemblyName>StudyJourney.Plugins.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\plugins\Countdown\Countdown.csproj" />
    <ProjectReference Include="..\..\plugins\Schedule\Schedule.csproj" />
  </ItemGroup>

</Project>
