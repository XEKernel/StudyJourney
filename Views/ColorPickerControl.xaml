<UserControl x:Class="GaokaoCountdown.Views.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="340" Height="420">
    <Border CornerRadius="8" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#12FFFFFF" CornerRadius="8,8,0,0">
                <TextBlock Text="选择颜色" FontSize="13" FontWeight="SemiBold"
                           Foreground="#FFE0E0F0" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </Border>

            <StackPanel Grid.Row="1" Margin="14,8,14,4">
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="4" BorderBrush="#30FFFFFF" BorderThickness="1"
                            Background="#222222">
                        <Rectangle x:Name="PreviewRect" RadiusX="3" RadiusY="3"/>
                    </Border>
                    <TextBox x:Name="HexBox" Text="#FFFFFF" Width="90" Margin="8,0,0,0" VerticalAlignment="Center"
                             FontSize="13" Background="#22FFFFFF" Foreground="White"
                             BorderBrush="#30FFFFFF" BorderThickness="1" Padding="6,3"/>
                </StackPanel>
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="R" Foreground="#FF8888" VerticalAlignment="Center" FontSize="11"/>
                    <Slider Grid.Column="1" x:Name="RSlider" Minimum="0" Maximum="255" Value="255"/>
                    <TextBlock Grid.Column="2" x:Name="RVal" Text="255" Foreground="#FF8888"
                               VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" Margin="0,0,4,0"/>
                    <TextBlock Grid.Row="1" Text="G" Foreground="#88FF88" VerticalAlignment="Center" FontSize="11"/>
                    <Slider Grid.Row="1" Grid.Column="1" x:Name="GSlider" Minimum="0" Maximum="255" Value="255"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="GVal" Text="255" Foreground="#88FF88"
                               VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" Margin="0,0,4,0"/>
                    <TextBlock Grid.Row="2" Text="B" Foreground="#8888FF" VerticalAlignment="Center" FontSize="11"/>
                    <Slider Grid.Row="2" Grid.Column="1" x:Name="BSlider" Minimum="0" Maximum="255" Value="255"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="BVal" Text="255" Foreground="#8888FF"
                               VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" Margin="0,0,4,0"/>
                </Grid>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="12,4,6,0">
                <Grid x:Name="PaletteGrid" Margin="0,2"/>
            </ScrollViewer>

            <TextBlock Grid.Row="3" Text="点击色块或拖动滑块选择，也可直接输入 HEX" FontSize="11"
                       Foreground="#66CCCCDD" Margin="14,2,0,2"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,14,0">
                <Button x:Name="BtnOk" Content="确定" Width="64"/>
                <Button x:Name="BtnCancel" Content="取消" Width="64"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
